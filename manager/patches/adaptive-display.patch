--- /dev/null
+++ b/crates/reims-vgpu/src/graphics/display_mode.rs
@@ -0,0 +1,256 @@
+//! Window mode policy. One approved mode feeds both queries and change notifications.
+//! No GPU calls or timers live here: the device's refresh thread polls with a monotonic clock.
+
+use std::time::{Duration, Instant};
+
+pub(super) type Size = (u64, u64);
+const SETTLE: Duration = Duration::from_millis(200);
+const ACK_TIMEOUT: Duration = Duration::from_secs(10);
+
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum Change {
+    Offered(Size),
+    TimedOut { requested: Size, restored: Size },
+}
+
+#[derive(Debug)]
+pub(super) struct Policy {
+    automatic: bool,
+    offered: Size,
+    confirmed: Size,
+    ready: bool,
+    seen: Option<Size>,
+    candidate: Option<(Size, Instant)>,
+    waiting: Option<Instant>,
+}
+
+/// Ignore zero/minimized drawables; bound allocations and keep the driver's row alignment.
+fn bounded((w, h): Size) -> Option<Size> {
+    if w < 800 || h < 600 {
+        return None;
+    }
+    Some((w.min(4096) / 16 * 16, h.min(2160) / 2 * 2))
+}
+
+impl Policy {
+    pub(super) fn new(first: Size, automatic: bool) -> Self {
+        Self {
+            automatic,
+            offered: first,
+            confirmed: first,
+            ready: false,
+            seen: None,
+            candidate: None,
+            waiting: None,
+        }
+    }
+
+    /// A scanout is the guest's acknowledgment, not merely a notification sent by the host.
+    pub(super) fn scanout(&mut self, size: Size) -> bool {
+        self.ready = true;
+        if self.waiting.is_none() && bounded(size).is_some() {
+            self.confirmed = size;
+        }
+        if size == self.offered {
+            self.confirmed = size;
+            return self.waiting.take().is_some();
+        }
+        false
+    }
+
+    pub(super) fn poll(&mut self, drawable: Option<Size>, now: Instant) -> (Size, Option<Change>) {
+        if !self.automatic {
+            return (self.offered, None);
+        }
+        let Some(size) = drawable.and_then(bounded) else {
+            self.candidate = None;
+            if self.seen.is_some() {
+                self.seen = Some(self.offered);
+            }
+            // A hidden surface cannot establish that the guest failed to redraw. Give it
+            // a fresh acknowledgment interval when rendering resumes.
+            if self.waiting.is_some() {
+                self.waiting = Some(now);
+            }
+            return (self.offered, None);
+        };
+        if self
+            .waiting
+            .is_some_and(|at| now.saturating_duration_since(at) >= ACK_TIMEOUT)
+        {
+            let requested = self.offered;
+            self.offered = self.confirmed;
+            self.automatic = false;
+            self.waiting = None;
+            self.candidate = None;
+            return (
+                self.offered,
+                Some(Change::TimedOut {
+                    requested,
+                    restored: self.offered,
+                }),
+            );
+        }
+        // The first drawable establishes the window's initial fit. Do not initiate a mode
+        // switch during firmware/OpenCore boot just because the host fit it to its desktop.
+        if self.seen.is_none() || !self.ready {
+            self.seen = Some(size);
+            self.candidate = None;
+            return (self.offered, None);
+        }
+        if self.seen != Some(size) {
+            self.seen = Some(size);
+            self.candidate = Some((size, now));
+        }
+        if size == self.offered {
+            self.candidate = None;
+        }
+        if self.waiting.is_none()
+            && let Some((target, since)) = self.candidate
+            && now.saturating_duration_since(since) >= SETTLE
+        {
+            self.offered = target;
+            self.waiting = Some(now);
+            self.candidate = None;
+            return (target, Some(Change::Offered(target)));
+        }
+        (self.offered, None)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn running() -> (Policy, Instant) {
+        let now = Instant::now();
+        let mut p = Policy::new((1920, 1080), true);
+        p.poll(Some((1920, 1080)), now);
+        p.scanout((1920, 1080));
+        (p, now)
+    }
+    fn ms(n: u64) -> Duration {
+        Duration::from_millis(n)
+    }
+
+    #[test]
+    fn drag_coalesces_and_queries_keep_the_previous_mode_until_settled() {
+        let (mut p, t) = running();
+        assert_eq!(p.poll(Some((2200, 1200)), t).0, (1920, 1080));
+        assert_eq!(p.poll(Some((2567, 1441)), t + ms(100)).0, (1920, 1080));
+        assert_eq!(p.poll(Some((2567, 1441)), t + ms(299)).1, None);
+        assert_eq!(
+            p.poll(Some((2567, 1441)), t + ms(300)),
+            ((2560, 1440), Some(Change::Offered((2560, 1440))))
+        );
+        assert_eq!(p.poll(Some((2567, 1441)), t + ms(301)).1, None);
+    }
+
+    #[test]
+    fn fixed_mode_does_not_follow_the_drawable_or_scanout() {
+        let mut p = Policy::new((2560, 1440), false);
+        p.scanout((1024, 768));
+        assert_eq!(p.poll(Some((3840, 2160)), Instant::now()).0, (2560, 1440));
+    }
+
+    #[test]
+    fn first_drawable_and_firmware_frames_do_not_trigger_adaptation() {
+        let mut p = Policy::new((2560, 1440), true);
+        let t = Instant::now();
+        p.poll(Some((2384, 1344)), t);
+        p.scanout((2560, 1440));
+        assert_eq!(
+            p.poll(Some((2384, 1344)), t + ms(60000)),
+            ((2560, 1440), None)
+        );
+    }
+
+    #[test]
+    fn a_second_resize_waits_for_guest_acknowledgment() {
+        let (mut p, t) = running();
+        p.poll(Some((2560, 1440)), t);
+        p.poll(Some((2560, 1440)), t + ms(200));
+        p.poll(Some((1600, 900)), t + ms(300));
+        assert_eq!(p.poll(Some((1600, 900)), t + ms(600)).0, (2560, 1440));
+        assert!(!p.scanout((1920, 1080)));
+        assert!(p.scanout((2560, 1440)));
+        assert_eq!(
+            p.poll(Some((1600, 900)), t + ms(601)).1,
+            Some(Change::Offered((1600, 900)))
+        );
+    }
+
+    #[test]
+    fn timeout_rolls_back_once_and_stops_retrying_even_after_late_ack() {
+        let (mut p, t) = running();
+        p.poll(Some((2560, 1440)), t);
+        p.poll(Some((2560, 1440)), t + ms(200));
+        assert_eq!(
+            p.poll(Some((2560, 1440)), t + ms(10200)).1,
+            Some(Change::TimedOut {
+                requested: (2560, 1440),
+                restored: (1920, 1080)
+            })
+        );
+        p.scanout((2560, 1440));
+        assert_eq!(
+            p.poll(Some((1600, 900)), t + ms(20000)),
+            ((1920, 1080), None)
+        );
+    }
+
+    #[test]
+    fn minimizes_and_oversized_windows_never_offer_invalid_allocations() {
+        let (mut p, t) = running();
+        p.poll(Some((2560, 1440)), t);
+        assert_eq!(p.poll(Some((0, 0)), t + ms(200)), ((1920, 1080), None));
+        p.poll(Some((u64::MAX, u64::MAX)), t + ms(300));
+        assert_eq!(
+            p.poll(Some((u64::MAX, u64::MAX)), t + ms(500)).0,
+            (4096, 2160)
+        );
+        assert_eq!(bounded((799, 600)), None);
+        assert_eq!(bounded((800, 600)), Some((800, 600)));
+    }
+
+    #[test]
+    fn restoring_after_minimize_restarts_the_settle_interval() {
+        let (mut p, t) = running();
+        p.poll(Some((2560, 1440)), t);
+        p.poll(Some((0, 0)), t + ms(100));
+        assert_eq!(p.poll(Some((2560, 1440)), t + ms(500)).0, (1920, 1080));
+        assert_eq!(
+            p.poll(Some((2560, 1440)), t + ms(700)).1,
+            Some(Change::Offered((2560, 1440)))
+        );
+    }
+
+    #[test]
+    fn hidden_window_does_not_timeout_an_unacknowledged_resize() {
+        let (mut p, t) = running();
+        p.poll(Some((2560, 1440)), t);
+        p.poll(Some((2560, 1440)), t + ms(200));
+        assert_eq!(p.poll(None, t + ms(30000)).1, None);
+        assert_eq!(p.poll(Some((2560, 1440)), t + ms(30100)).1, None);
+        assert!(p.scanout((2560, 1440)));
+        p.poll(Some((1600, 900)), t + ms(30200));
+        assert_eq!(
+            p.poll(Some((1600, 900)), t + ms(30400)).1,
+            Some(Change::Offered((1600, 900)))
+        );
+    }
+
+    #[test]
+    fn rollback_uses_last_acknowledged_mode_and_returning_to_it_cancels_drag() {
+        let (mut p, t) = running();
+        p.poll(Some((2560, 1440)), t);
+        p.poll(Some((2560, 1440)), t + ms(200));
+        p.scanout((2560, 1440));
+        p.poll(Some((1600, 900)), t + ms(300));
+        assert_eq!(p.poll(Some((2560, 1440)), t + ms(400)).1, None);
+        assert_eq!(p.poll(Some((2560, 1440)), t + ms(600)).1, None);
+        p.poll(Some((1600, 900)), t + ms(700));
+        p.poll(Some((1600, 900)), t + ms(900));
+        assert_eq!(p.poll(Some((1600, 900)), t + ms(10900)).0, (2560, 1440));
+    }
+}
