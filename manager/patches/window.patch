+/// Enters full screen (`Some(true)`), leaves it (`Some(false)`) or does the other of the two
+/// (`None`): the compositor's own full screen on the window's screen. A window that leaves it is
+/// the size and place it was before.
+pub(crate) fn set_full_screen(shell: &Shell, full: Option<bool>) {
+    // SAFETY: the window is SDL's, on this thread.
+    let now = (unsafe { SDL_GetWindowFlags(shell.sdl) } & SDL_WINDOW_FULLSCREEN).0 != 0;
+    let full = full.unwrap_or(!now);
+    if full == now {
+        return;
+    }
