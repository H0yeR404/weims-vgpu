@@ -0,0 +1,75 @@
+//! Full screen asked for from outside the process: a program on the host posts the registered
+//! message [`MESSAGE`] to a display's window (the top-level window of class `SDL_app` in QEMU's
+//! process), with what it asks in `wParam`: 0 for a window, 1 for full screen, anything else for
+//! the other of the two. SDL's message hook sees the message as SDL takes it off the UI thread's
+//! queue, and what it asks is posted to that thread
+//! (`super::super::sdl_thread::sdl::full_screen_asked`).
+
+use std::cell::Cell;
+use std::ffi::c_void;
+
+use sdl3_sys::everything::SDL_SetWindowsMessageHook;
+
+use super::win32::{MSG, RegisterWindowMessageW, wide};
+
+/// The message's name, which `RegisterWindowMessageW` gives every process the same number for.
+pub(crate) const MESSAGE: &str = "ReimsVgpuWindow.FullScreen";
+
+thread_local! {
+    /// The message's number on this system, once the UI thread listens; 0 before.
+    static NUMBER: Cell<u32> = const { Cell::new(0) };
+}
+
+/// What `wparam` asks: full screen, a window, or the other of the two (`None`).
+fn asked(wparam: usize) -> Option<bool> {
+    match wparam {
+        0 => Some(false),
+        1 => Some(true),
+        _ => None,
+    }
+}
+
+/// Listens for the message on the UI thread, once.
+pub(crate) fn listen() {
+    if NUMBER.with(Cell::get) != 0 {
+        return;
+    }
+    let name = wide(MESSAGE);
+    // SAFETY: the name is valid for the call.
+    let number = unsafe { RegisterWindowMessageW(name.as_ptr()) };
+    if number == 0 {
+        log::warn!(
+            target: "reims_vgpu_window",
+            "the message {MESSAGE} is refused: full screen is not asked for from outside"
+        );
+        return;
+    }
+    NUMBER.with(|n| n.set(number));
+    // SAFETY: SDL's video runs on this thread; the hook is this module's, for the process.
+    unsafe { SDL_SetWindowsMessageHook(Some(hook), std::ptr::null_mut()) };
+}
+
+/// SDL's message hook: the registered message is taken, every other is SDL's.
+unsafe extern "C" fn hook(_userdata: *mut c_void, msg: *mut sdl3_sys::everything::MSG) -> bool {
+    // SAFETY: SDL hands the `MSG` it took off the queue, valid for the call.
+    let msg = unsafe { &*msg.cast::<MSG>() };
+    if msg.message != NUMBER.with(Cell::get) {
+        return true;
+    }
+    crate::native::sdl_thread::sdl::full_screen_asked(msg.hwnd as isize, asked(msg.wParam));
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// 0 asks for a window, 1 for full screen, anything else for the other of the two
+    #[test]
+    fn the_message_s_value_says_which() {
+        assert_eq!(asked(0), Some(false));
+        assert_eq!(asked(1), Some(true));
+        assert_eq!(asked(2), None);
+        assert_eq!(asked(usize::MAX), None);
+    }
+}
diff --git a/crates/reims-vgpu-window/src/native/windows/superkey.rs b/crates/reims-vgpu-window/src/native/windows/superkey.rs
new file mode 100644
index 000000000..60658447d
--- /dev/null
+++ b/crates/reims-vgpu-window/src/native/windows/superkey.rs
@@ -0,0 +1,254 @@
+//! The Windows keys for the guest, where a click does not capture
+//! (`REIMS_VGPU_WINDOW_FREE_POINTER`): while the window has the keyboard and the pointer is over
+//! the image, the left and right Windows keys go to the guest, its Command keys, and Windows
+//! opens no Start menu and takes none of its Windows-key shortcuts. Every other key of the host's
+//! stays the host's (Alt+Tab, Ctrl+Esc), which SDL's keyboard grab would take too.
+//!
+//! A low-level keyboard hook on the UI thread, installed while a window takes the keys
+//! ([`follow`]) or a key it took is still down. Windows calls it on that thread between its
+//! events. A Windows key that goes down while a window takes them is kept from Windows and
+//! pushed to that window as SDL's key event, which reaches the guest as any key does
+//! (`super::super::sdl_thread::input`); its up goes the same way wherever the pointer is by
+//! then, so the guest's Command key never sticks and Windows never sees an up without its down.
+//! A key that went down outside stays the host's, up included. Win+L is Windows's own: no hook
+//! sees it.
+
+use std::sync::atomic::{AtomicIsize, AtomicU32, Ordering::Relaxed};
+
+use sdl3_sys::everything::*;
+
+use super::win32::*;
+
+/// The hook, while installed.
+static HOOK: AtomicIsize = AtomicIsize::new(0);
+/// Whether Windows has refused the hook, which the log says once.
+static REFUSED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// SDL's ID of the window that takes the Windows keys; 0 for none.
+static TARGET: AtomicU32 = AtomicU32::new(0);
+/// For the left and the right Windows key: SDL's ID of the window its down went to, [`HOST`]
+/// while it is down for the host, 0 while it is up.
+static HELD: [AtomicU32; 2] = [AtomicU32::new(0), AtomicU32::new(0)];
+/// What [`HELD`] says of a key that went down for the host. SDL gives no window this ID.
+const HOST: u32 = u32::MAX;
+
+/// What the hook does with a Windows key going down (`down`) or up.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Step {
+    /// The host's: passed on.
+    Pass,
+    /// The guest's: kept from the host and sent to this window, as a repeat or not.
+    Send {
+        /// SDL's ID of the window.
+        window: u32,
+        /// The host's repeat of a key already down.
+        repeat: bool,
+    },
+}
+
+/// What becomes of a Windows key event: `target` takes the keys (0 for none), and `held` is
+/// where the key's down went ([`HELD`]). The step, and what `held` is from then on. A key stays
+/// with whoever got its down, repeats and up included, wherever the pointer goes meanwhile.
+fn step(down: bool, target: u32, held: u32) -> (Step, u32) {
+    match (down, target, held) {
+        (true, _, HOST) | (true, 0, 0) => (Step::Pass, HOST),
+        (true, target, 0) => (
+            Step::Send {
+                window: target,
+                repeat: false,
+            },
+            target,
+        ),
+        (true, _, held) => (
+            Step::Send {
+                window: held,
+                repeat: true,
+            },
+            held,
+        ),
+        (false, _, 0 | HOST) => (Step::Pass, 0),
+        (false, _, held) => (
+            Step::Send {
+                window: held,
+                repeat: false,
+            },
+            0,
+        ),
+    }
+}
+
+/// Window `window` (SDL's ID) takes the Windows keys (`takes`) or no longer does: whether that
+/// changed. The hook is installed while any window takes them or a key is still down in the
+/// guest, and removed otherwise.
+pub(crate) fn follow(window: u32, takes: bool) -> bool {
+    let target = TARGET.load(Relaxed);
+    let changed = if takes && target != window {
+        TARGET.store(window, Relaxed);
+        true
+    } else if !takes && target == window {
+        TARGET.store(0, Relaxed);
+        true
+    } else {
+        false
+    };
+    let wanted = TARGET.load(Relaxed) != 0 || HELD.iter().any(|held| held.load(Relaxed) != 0);
+    let hook = HOOK.load(Relaxed);
+    if wanted && hook == 0 {
+        // SAFETY: the procedure is this module's, for the process's lifetime; a null module name
+        // names the process's own.
+        let installed = unsafe {
+            SetWindowsHookExW(
+                WH_KEYBOARD_LL,
+                hook_proc,
+                GetModuleHandleW(std::ptr::null()),
+                0,
+            )
+        };
+        // Said once: the hook is asked for again at every event while a window takes the keys.
+        if installed.is_null() && !REFUSED.swap(true, Relaxed) {
+            log::warn!(
+                target: "reims_vgpu_window",
+                "no keyboard hook: the Windows keys stay the host's"
+            );
+        }
+        HOOK.store(installed as isize, Relaxed);
+    } else if !wanted && hook != 0 {
+        // SAFETY: the hook is the one installed above, on this thread.
+        unsafe { UnhookWindowsHookEx(hook as HANDLE) };
+        HOOK.store(0, Relaxed);
+    }
+    changed
+}
+
+/// Window `window` is going: it takes no key, and none is down in it.
+pub(crate) fn forget(window: u32) {
+    for held in &HELD {
+        // The guest was sent the key's up at the window's end; the key's own up then goes to the
+        // host, which never saw its down.
+        let _ = held.compare_exchange(window, 0, Relaxed, Relaxed);
+    }
+    follow(window, false);
+}
+
+/// The hook: a Windows key is the guest's or the host's ([`step`]).
+unsafe extern "system" fn hook_proc(code: i32, wparam: usize, lparam: isize) -> isize {
+    if code == HC_ACTION {
+        // SAFETY: for `HC_ACTION` Windows hands a `KBDLLHOOKSTRUCT`, valid for the call.
+        let key = unsafe { &*(lparam as *const KBDLLHOOKSTRUCT) };
+        let side = match key.vkCode {
+            VK_LWIN => Some(0),
+            VK_RWIN => Some(1),
+            _ => None,
+        };
+        if let Some(side) = side {
+            let down = matches!(wparam as u32, WM_KEYDOWN | WM_SYSKEYDOWN);
+            let (step, held) = step(down, TARGET.load(Relaxed), HELD[side].load(Relaxed));
+            HELD[side].store(held, Relaxed);
+            if let Step::Send { window, repeat } = step {
+                push(window, side, down, repeat);
+                return 1;
+            }
+        }
+    }
+    // SAFETY: the values are Windows's own, passed on as it asks.
+    unsafe { CallNextHookEx(std::ptr::null_mut(), code, wparam, lparam) }
+}
+
+/// Pushes the left (`side` 0) or right Windows key going down or up to window `window` as SDL's
+/// key event.
+fn push(window: u32, side: usize, down: bool, repeat: bool) {
+    // SAFETY: an all-zero key event is a valid one to fill.
+    let mut key: SDL_KeyboardEvent = unsafe { std::mem::zeroed() };
+    key.r#type = if down {
+        SDL_EVENT_KEY_DOWN
+    } else {
+        SDL_EVENT_KEY_UP
+    };
+    // SAFETY: SDL's clock, read on its thread.
+    key.timestamp = unsafe { SDL_GetTicksNS() };
+    key.windowID = SDL_WindowID(window);
+    key.scancode = if side == 0 {
+        SDL_SCANCODE_LGUI
+    } else {
+        SDL_SCANCODE_RGUI
+    };
+    key.down = down;
+    key.repeat = repeat;
+    // SAFETY: as above.
+    let mut event: SDL_Event = unsafe { std::mem::zeroed() };
+    event.key = key;
+    // SAFETY: SDL copies the event into its queue.
+    unsafe { SDL_PushEvent(&mut event) };
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A Windows key that goes down while a window takes them is the guest's, and its up too
+    #[test]
+    fn a_windows_key_over_the_image_is_the_guest_s_down_and_up() {
+        let (down, held) = step(true, 7, 0);
+        assert_eq!(
+            down,
+            Step::Send {
+                window: 7,
+                repeat: false
+            }
+        );
+        assert_eq!(held, 7);
+        let (repeat, held) = step(true, 7, held);
+        assert_eq!(
+            repeat,
+            Step::Send {
+                window: 7,
+                repeat: true
+            }
+        );
+        let (up, held) = step(false, 7, held);
+        assert_eq!(
+            up,
+            Step::Send {
+                window: 7,
+                repeat: false
+            }
+        );
+        assert_eq!(held, 0);
+    }
+
+    /// The up of a key the guest took reaches the guest though the pointer has left the image
+    #[test]
+    fn the_up_follows_its_down_after_the_pointer_left() {
+        let (_, held) = step(true, 7, 0);
+        assert_eq!(
+            step(true, 0, held),
+            (
+                Step::Send {
+                    window: 7,
+                    repeat: true
+                },
+                7
+            )
+        );
+        assert_eq!(
+            step(false, 0, held),
+            (
+                Step::Send {
+                    window: 7,
+                    repeat: false
+                },
+                0
+            )
+        );
+    }
+
+    /// A Windows key that went down for the host stays the host's, its repeats and its up,
+    /// though the pointer enters the image before it comes up
+    #[test]
+    fn a_key_down_outside_stays_the_host_s() {
+        let (down, held) = step(true, 0, 0);
+        assert_eq!((down, held), (Step::Pass, HOST));
+        assert_eq!(step(true, 7, held), (Step::Pass, HOST));
+        assert_eq!(step(false, 7, held), (Step::Pass, 0));
+        assert_eq!(step(false, 7, 0), (Step::Pass, 0));
+    }
+}
diff --git a/crates/reims-vgpu-window/src/native/windows/win32.rs b/crates/reims-vgpu-window/src/native/windows/win32.rs
new file mode 100644
index 000000000..8aa6742d1
--- /dev/null
+++ b/crates/reims-vgpu-window/src/native/windows/win32.rs
@@ -0,0 +1,293 @@
+//! The Win32 calls the window makes itself, beside SDL's: a low-level keyboard hook
+//! (`super::superkey`), a small window of its own (`super::bar`) and a registered message
+//! (`super::remote`). Declared here as Windows documents them, so the crate takes no dependency
+//! for them; every call is made on the UI thread.
+
+#![allow(non_snake_case, clippy::upper_case_acronyms)]
+
+use std::ffi::c_void;
+
+/// A window's handle.
+pub(crate) type HWND = *mut c_void;
+/// Any other handle: a module, a hook, a device context, a GDI object.
+pub(crate) type HANDLE = *mut c_void;
+/// A window procedure.
+pub(crate) type WNDPROC = unsafe extern "system" fn(HWND, u32, usize, isize) -> isize;
+/// A hook procedure.
+pub(crate) type HOOKPROC = unsafe extern "system" fn(i32, usize, isize) -> isize;
+
+/// `POINT`.
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub(crate) struct POINT {
+    /// Across.
+    pub(crate) x: i32,
+    /// Down.
+    pub(crate) y: i32,
+}
+
+/// `RECT`.
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub(crate) struct RECT {
+    /// The left edge.
+    pub(crate) left: i32,
+    /// The top edge.
+    pub(crate) top: i32,
+    /// One past the right edge.
+    pub(crate) right: i32,
+    /// One past the bottom edge.
+    pub(crate) bottom: i32,
+}
+
+/// `MSG`, which SDL's message hook is handed.
+#[repr(C)]
+pub(crate) struct MSG {
+    /// The window it is for.
+    pub(crate) hwnd: HWND,
+    /// Which message.
+    pub(crate) message: u32,
+    /// Its first value.
+    pub(crate) wParam: usize,
+    /// Its second value.
+    pub(crate) lParam: isize,
+    /// When it was posted.
+    pub(crate) time: u32,
+    /// Where the pointer was.
+    pub(crate) pt: POINT,
+}
+
+/// `KBDLLHOOKSTRUCT`, which a low-level keyboard hook is handed.
+#[repr(C)]
+pub(crate) struct KBDLLHOOKSTRUCT {
+    /// The virtual key.
+    pub(crate) vkCode: u32,
+    /// Its scan code.
+    pub(crate) scanCode: u32,
+    /// `LLKHF_*`.
+    pub(crate) flags: u32,
+    /// When.
+    pub(crate) time: u32,
+    /// The sender's own value.
+    pub(crate) dwExtraInfo: usize,
+}
+
+/// `WNDCLASSEXW`.
+#[repr(C)]
+pub(crate) struct WNDCLASSEXW {
+    /// The structure's size.
+    pub(crate) cbSize: u32,
+    /// `CS_*`.
+    pub(crate) style: u32,
+    /// The class's window procedure.
+    pub(crate) lpfnWndProc: Option<WNDPROC>,
+    /// Extra bytes after the class.
+    pub(crate) cbClsExtra: i32,
+    /// Extra bytes after each window.
+    pub(crate) cbWndExtra: i32,
+    /// The module the procedure is in.
+    pub(crate) hInstance: HANDLE,
+    /// The class's icon.
+    pub(crate) hIcon: HANDLE,
+    /// The class's cursor.
+    pub(crate) hCursor: HANDLE,
+    /// The class's background brush.
+    pub(crate) hbrBackground: HANDLE,
+    /// The class's menu.
+    pub(crate) lpszMenuName: *const u16,
+    /// The class's name.
+    pub(crate) lpszClassName: *const u16,
+    /// The class's small icon.
+    pub(crate) hIconSm: HANDLE,
+}
+
+/// `PAINTSTRUCT`.
+#[repr(C)]
+pub(crate) struct PAINTSTRUCT {
+    /// The device context to paint in.
+    pub(crate) hdc: HANDLE,
+    /// Whether the background is to be erased.
+    pub(crate) fErase: i32,
+    /// What to paint.
+    pub(crate) rcPaint: RECT,
+    /// Windows's own.
+    pub(crate) fRestore: i32,
+    /// Windows's own.
+    pub(crate) fIncUpdate: i32,
+    /// Windows's own.
+    pub(crate) rgbReserved: [u8; 32],
+}
+
+/// `TRACKMOUSEEVENT`.
+#[repr(C)]
+pub(crate) struct TRACKMOUSEEVENT {
+    /// The structure's size.
+    pub(crate) cbSize: u32,
+    /// `TME_*`.
+    pub(crate) dwFlags: u32,
+    /// The window to track the pointer over.
+    pub(crate) hwndTrack: HWND,
+    /// The hover time.
+    pub(crate) dwHoverTime: u32,
+}
+
+/// `WH_KEYBOARD_LL`.
+pub(crate) const WH_KEYBOARD_LL: i32 = 13;
+/// `HC_ACTION`.
+pub(crate) const HC_ACTION: i32 = 0;
+/// `VK_LWIN`.
+pub(crate) const VK_LWIN: u32 = 0x5B;
+/// `VK_RWIN`.
+pub(crate) const VK_RWIN: u32 = 0x5C;
+
+/// `WM_PAINT`.
+pub(crate) const WM_PAINT: u32 = 0x000F;
+/// `WM_ERASEBKGND`.
+pub(crate) const WM_ERASEBKGND: u32 = 0x0014;
+/// `WM_MOUSEACTIVATE`.
+pub(crate) const WM_MOUSEACTIVATE: u32 = 0x0021;
+/// `WM_KEYDOWN`.
+pub(crate) const WM_KEYDOWN: u32 = 0x0100;
+/// `WM_SYSKEYDOWN`.
+pub(crate) const WM_SYSKEYDOWN: u32 = 0x0104;
+/// `WM_TIMER`.
+pub(crate) const WM_TIMER: u32 = 0x0113;
+/// `WM_MOUSEMOVE`.
+pub(crate) const WM_MOUSEMOVE: u32 = 0x0200;
+/// `WM_LBUTTONDOWN`.
+pub(crate) const WM_LBUTTONDOWN: u32 = 0x0201;
+/// `WM_LBUTTONUP`.
+pub(crate) const WM_LBUTTONUP: u32 = 0x0202;
+/// `WM_MOUSELEAVE`.
+pub(crate) const WM_MOUSELEAVE: u32 = 0x02A3;
+/// `MA_NOACTIVATE`.
+pub(crate) const MA_NOACTIVATE: isize = 3;
+
+/// `WS_POPUP`.
+pub(crate) const WS_POPUP: u32 = 0x8000_0000;
+/// `WS_EX_TOOLWINDOW`.
+pub(crate) const WS_EX_TOOLWINDOW: u32 = 0x0000_0080;
+/// `WS_EX_NOACTIVATE`.
+pub(crate) const WS_EX_NOACTIVATE: u32 = 0x0800_0000;
+/// `SW_HIDE`.
+pub(crate) const SW_HIDE: i32 = 0;
+/// `SWP_NOACTIVATE`.
+pub(crate) const SWP_NOACTIVATE: u32 = 0x0010;
+/// `SWP_SHOWWINDOW`.
+pub(crate) const SWP_SHOWWINDOW: u32 = 0x0040;
+/// `TME_LEAVE`.
+pub(crate) const TME_LEAVE: u32 = 0x0002;
+/// `IDC_ARROW`, as `LoadCursorW` takes it.
+pub(crate) const IDC_ARROW: *const u16 = 32512 as *const u16;
+
+/// `TRANSPARENT`, a background mode.
+pub(crate) const TRANSPARENT: i32 = 1;
+/// `DT_CENTER`.
+pub(crate) const DT_CENTER: u32 = 0x0001;
+/// `DT_VCENTER`.
+pub(crate) const DT_VCENTER: u32 = 0x0004;
+/// `DT_SINGLELINE`.
+pub(crate) const DT_SINGLELINE: u32 = 0x0020;
+/// `DT_NOPREFIX`.
+pub(crate) const DT_NOPREFIX: u32 = 0x0800;
+/// `DT_END_ELLIPSIS`.
+pub(crate) const DT_END_ELLIPSIS: u32 = 0x8000;
+/// `CLEARTYPE_QUALITY`.
+pub(crate) const CLEARTYPE_QUALITY: u32 = 5;
+/// `DEFAULT_CHARSET`.
+pub(crate) const DEFAULT_CHARSET: u32 = 1;
+
+#[link(name = "user32")]
+unsafe extern "system" {
+    pub(crate) fn SetWindowsHookExW(id: i32, proc: HOOKPROC, module: HANDLE, thread: u32)
+    -> HANDLE;
+    pub(crate) fn UnhookWindowsHookEx(hook: HANDLE) -> i32;
+    pub(crate) fn CallNextHookEx(hook: HANDLE, code: i32, wparam: usize, lparam: isize) -> isize;
+    pub(crate) fn RegisterWindowMessageW(name: *const u16) -> u32;
+    pub(crate) fn RegisterClassExW(class: *const WNDCLASSEXW) -> u16;
+    pub(crate) fn CreateWindowExW(
+        ex_style: u32,
+        class: *const u16,
+        name: *const u16,
+        style: u32,
+        x: i32,
+        y: i32,
+        width: i32,
+        height: i32,
+        parent: HWND,
+        menu: HANDLE,
+        instance: HANDLE,
+        param: *mut c_void,
+    ) -> HWND;
+    pub(crate) fn DestroyWindow(hwnd: HWND) -> i32;
+    pub(crate) fn DefWindowProcW(hwnd: HWND, message: u32, wparam: usize, lparam: isize) -> isize;
+    pub(crate) fn ShowWindow(hwnd: HWND, show: i32) -> i32;
+    pub(crate) fn SetWindowPos(
+        hwnd: HWND,
+        after: HWND,
+        x: i32,
+        y: i32,
+        width: i32,
+        height: i32,
+        flags: u32,
+    ) -> i32;
+    pub(crate) fn GetWindowRect(hwnd: HWND, rect: *mut RECT) -> i32;
+    pub(crate) fn GetClientRect(hwnd: HWND, rect: *mut RECT) -> i32;
+    pub(crate) fn GetCursorPos(point: *mut POINT) -> i32;
+    pub(crate) fn GetForegroundWindow() -> HWND;
+    pub(crate) fn IsIconic(hwnd: HWND) -> i32;
+    pub(crate) fn GetDpiForWindow(hwnd: HWND) -> u32;
+    pub(crate) fn SetTimer(hwnd: HWND, id: usize, ms: u32, proc: *const c_void) -> usize;
+    pub(crate) fn KillTimer(hwnd: HWND, id: usize) -> i32;
+    pub(crate) fn InvalidateRect(hwnd: HWND, rect: *const RECT, erase: i32) -> i32;
+    pub(crate) fn BeginPaint(hwnd: HWND, paint: *mut PAINTSTRUCT) -> HANDLE;
+    pub(crate) fn EndPaint(hwnd: HWND, paint: *const PAINTSTRUCT) -> i32;
+    pub(crate) fn FillRect(dc: HANDLE, rect: *const RECT, brush: HANDLE) -> i32;
+    pub(crate) fn DrawTextW(
+        dc: HANDLE,
+        text: *const u16,
+        length: i32,
+        rect: *mut RECT,
+        format: u32,
+    ) -> i32;
+    pub(crate) fn TrackMouseEvent(track: *mut TRACKMOUSEEVENT) -> i32;
+    pub(crate) fn LoadCursorW(instance: HANDLE, name: *const u16) -> HANDLE;
+}
+
+#[link(name = "gdi32")]
+unsafe extern "system" {
+    pub(crate) fn CreateSolidBrush(color: u32) -> HANDLE;
+    pub(crate) fn DeleteObject(object: HANDLE) -> i32;
+    pub(crate) fn SelectObject(dc: HANDLE, object: HANDLE) -> HANDLE;
+    pub(crate) fn SetBkMode(dc: HANDLE, mode: i32) -> i32;
+    pub(crate) fn SetTextColor(dc: HANDLE, color: u32) -> u32;
+    pub(crate) fn CreateFontW(
+        height: i32,
+        width: i32,
+        escapement: i32,
+        orientation: i32,
+        weight: i32,
+        italic: u32,
+        underline: u32,
+        strike_out: u32,
+        char_set: u32,
+        out_precision: u32,
+        clip_precision: u32,
+        quality: u32,
+        pitch_and_family: u32,
+        face: *const u16,
+    ) -> HANDLE;
+}
+
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    pub(crate) fn GetModuleHandleW(name: *const u16) -> HANDLE;
+}
+
+/// `text` as Windows takes a string: UTF-16, NUL-terminated.
+pub(crate) fn wide(text: &str) -> Vec<u16> {
+    text.encode_utf16()
+        .filter(|&unit| unit != 0)
+        .chain(std::iter::once(0))
+        .collect()
+}
