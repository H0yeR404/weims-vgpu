@@ -0,0 +1,602 @@
+//! The full-screen bar: a small window at the top of a full-screen window's screen, hidden until
+//! the pointer rests at the screen's top edge over where it shows, with the window's title, the
+//! chord that leaves full screen, and two buttons, minimize and back to a window.
+//!
+//! - **Shown and hidden** by a timer of its own, [`TICK_MS`] apart, which reads where the
+//!   pointer is: hidden, the bar shows once the pointer has stayed [`SHOW_TICKS`] ticks in the
+//!   top [`REVEAL`] pixels of the screen, within the bar's own width, so the pointer on its way
+//!   to the guest's menus at the left and right of the top edge shows nothing; shown, it hides
+//!   once the pointer has been [`HIDE_TICKS`] ticks away from it, and at once when its window
+//!   is no longer the foreground one.
+//! - **Its own window**, owned by SDL's, so Windows keeps it over that one and hides it with it.
+//!   It never takes the keyboard (`WS_EX_NOACTIVATE`, `MA_NOACTIVATE`): a click on it leaves the
+//!   keyboard with the guest's window. Its messages are pumped by SDL on the UI thread with the
+//!   window's own.
+//! - **Its buttons** post what the person asked to the UI thread
+//!   (`super::super::sdl_thread::sdl::bar_asked`), which runs it between events, never inside
+//!   the bar's window procedure.
+
+use std::cell::{Cell, RefCell};
+
+use super::win32::*;
+
+/// The timer's period, in ms.
+const TICK_MS: u32 = 50;
+/// Ticks the pointer rests at the top edge before the bar shows: a quarter of a second.
+const SHOW_TICKS: u8 = 5;
+/// Ticks the pointer is away from the bar before it hides: 0.6 s.
+const HIDE_TICKS: u8 = 12;
+/// The rows of the screen's top the pointer shows the bar from, in pixels.
+const REVEAL: i32 = 2;
+/// How far around the shown bar the pointer still counts as on it, in pixels at 96 DPI.
+const MARGIN: i32 = 12;
+
+/// The bar's colours, as `COLORREF` (0x00BBGGRR).
+const BACK: u32 = 0x002B_2B2B;
+/// A button under the pointer.
+const HOVER: u32 = 0x0048_4848;
+/// A button held down.
+const PRESSED: u32 = 0x0060_6060;
+/// The text and the glyphs.
+const TEXT: u32 = 0x00F0_F0F0;
+
+/// Segoe MDL2 Assets' ChromeMinimize.
+const GLYPH_MINIMIZE: u16 = 0xE921;
+/// Segoe MDL2 Assets' ChromeRestore: back to a window.
+const GLYPH_WINDOWED: u16 = 0xE923;
+
+/// What the person asked of the bar.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Asked {
+    /// Minimize the window.
+    Minimize,
+    /// Leave full screen.
+    Windowed,
+}
+
+/// The bar's sizes in pixels at a DPI.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Sizes {
+    /// The whole bar's width.
+    width: i32,
+    /// Its height.
+    height: i32,
+    /// The label's width, at the left.
+    label: i32,
+    /// A button's width.
+    button: i32,
+    /// The room left of the label.
+    pad: i32,
+}
+
+/// The bar's sizes at `dpi`.
+fn sizes(dpi: u32) -> Sizes {
+    let px = |at_96: i32| at_96 * dpi.max(96) as i32 / 96;
+    let (label, button) = (px(250), px(44));
+    Sizes {
+        width: label + 2 * button,
+        height: px(30),
+        label,
+        button,
+        pad: px(12),
+    }
+}
+
+/// The button at `x`, pixels from the bar's left.
+fn button_at(x: i32, sizes: Sizes) -> Option<Asked> {
+    match (x - sizes.label).div_euclid(sizes.button) {
+        0 if x >= sizes.label => Some(Asked::Minimize),
+        1 => Some(Asked::Windowed),
+        _ => None,
+    }
+}
+
+/// Where the bar is on its window's screen: `screen` is the full-screen window's rectangle, the
+/// bar centred at its top.
+fn place(screen: RECT, sizes: Sizes) -> RECT {
+    let left = screen.left + (screen.right - screen.left - sizes.width) / 2;
+    RECT {
+        left,
+        top: screen.top,
+        right: left + sizes.width,
+        bottom: screen.top + sizes.height,
+    }
+}
+
+/// Whether the pointer at `at` counts for the bar at `bar`: shown, on it or within `margin` of
+/// it; hidden, in the top [`REVEAL`] rows of the screen within its width.
+fn in_reach(at: POINT, bar: RECT, shown: bool, margin: i32) -> bool {
+    if shown {
+        at.x >= bar.left - margin
+            && at.x < bar.right + margin
+            && at.y >= bar.top
+            && at.y < bar.bottom + margin
+    } else {
+        at.x >= bar.left && at.x < bar.right && at.y >= bar.top && at.y < bar.top + REVEAL
+    }
+}
+
+/// One tick: `dwell` ticks so far toward a change, the bar `shown` or not, the pointer in reach
+/// (`reach`, [`in_reach`]) and the window the foreground one (`front`). The ticks from then on,
+/// and whether the bar shows (`Some(true)`) or hides now.
+fn tick_step(dwell: u8, shown: bool, reach: bool, front: bool) -> (u8, Option<bool>) {
+    match (shown, reach && front) {
+        (false, true) if dwell + 1 >= SHOW_TICKS => (0, Some(true)),
+        (true, false) if !front || dwell + 1 >= HIDE_TICKS => (0, Some(false)),
+        (false, true) | (true, false) => (dwell + 1, None),
+        _ => (0, None),
+    }
+}
+
+/// A bar.
+#[derive(Clone)]
+struct Bar {
+    /// Its window.
+    hwnd: isize,
+    /// SDL's window, which owns it.
+    owner: isize,
+    /// The crate's ID of the window it is for.
+    window: u64,
+    /// What it says at its left, as Windows takes a string.
+    label: Vec<u16>,
+    /// Whether it shows.
+    shown: bool,
+    /// The ticks toward showing or hiding ([`tick_step`]).
+    dwell: u8,
+    /// The button under the pointer.
+    hover: Option<Asked>,
+    /// The button the left button went down on.
+    pressed: Option<Asked>,
+    /// Whether the pointer's leaving is asked for (`TrackMouseEvent`).
+    tracking: bool,
+}
+
+thread_local! {
+    /// The bars open, on the UI thread. Borrowed for a read or a write of a bar's own values
+    /// only, never across a call into Windows, which may call the window procedure again.
+    static BARS: RefCell<Vec<Bar>> = const { RefCell::new(Vec::new()) };
+    /// Whether the bar's window class is registered.
+    static REGISTERED: Cell<bool> = const { Cell::new(false) };
+}
+
+/// The bar of window `hwnd`, as it is now.
+fn bar_of(hwnd: HWND) -> Option<Bar> {
+    BARS.with(|bars| {
+        bars.borrow()
+            .iter()
+            .find(|bar| bar.hwnd == hwnd as isize)
+            .cloned()
+    })
+}
+
+/// Changes the bar of window `hwnd`.
+fn change(hwnd: HWND, f: impl FnOnce(&mut Bar)) {
+    BARS.with(|bars| {
+        if let Some(bar) = bars
+            .borrow_mut()
+            .iter_mut()
+            .find(|bar| bar.hwnd == hwnd as isize)
+        {
+            f(bar);
+        }
+    });
+}
+
+/// The bar's window class's name.
+fn class_name() -> Vec<u16> {
+    wide("ReimsVgpuFullScreenBar")
+}
+
+/// Opens the bar of SDL's window `owner`, full screen, for the crate's window `window`, titled
+/// `title`: hidden until the pointer rests at the top edge (the module doc). Nothing where it
+/// has one.
+pub(crate) fn open(owner: HWND, window: u64, title: &str) {
+    if owner.is_null() || BARS.with(|bars| bars.borrow().iter().any(|b| b.owner == owner as isize))
+    {
+        return;
+    }
+    let class = class_name();
+    // SAFETY: a null module name names the process's own module.
+    let instance = unsafe { GetModuleHandleW(std::ptr::null()) };
+    if !REGISTERED.with(Cell::get) {
+        let definition = WNDCLASSEXW {
+            cbSize: size_of::<WNDCLASSEXW>() as u32,
+            style: 0,
+            lpfnWndProc: Some(window_proc),
+            cbClsExtra: 0,
+            cbWndExtra: 0,
+            hInstance: instance,
+            hIcon: std::ptr::null_mut(),
+            // SAFETY: the system's arrow, which needs no module.
+            hCursor: unsafe { LoadCursorW(std::ptr::null_mut(), IDC_ARROW) },
+            hbrBackground: std::ptr::null_mut(),
+            lpszMenuName: std::ptr::null(),
+            lpszClassName: class.as_ptr(),
+            hIconSm: std::ptr::null_mut(),
+        };
+        // SAFETY: the class's strings outlive the call, and its procedure the process.
+        if unsafe { RegisterClassExW(&definition) } == 0 {
+            log::warn!(target: "reims_vgpu_window", "no full-screen bar: its class is refused");
+            return;
+        }
+        REGISTERED.with(|registered| registered.set(true));
+    }
+    // SAFETY: the class is registered; the owner is SDL's window, on this thread.
+    let hwnd = unsafe {
+        CreateWindowExW(
+            WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE,
+            class.as_ptr(),
+            std::ptr::null(),
+            WS_POPUP,
+            0,
+            0,
+            0,
+            0,
+            owner,
+            std::ptr::null_mut(),
+            instance,
+            std::ptr::null_mut(),
+        )
+    };
+    if hwnd.is_null() {
+        log::warn!(target: "reims_vgpu_window", "no full-screen bar: its window is refused");
+        return;
+    }
+    BARS.with(|bars| {
+        bars.borrow_mut().push(Bar {
+            hwnd: hwnd as isize,
+            owner: owner as isize,
+            window,
+            label: wide(&format!("{title}  \u{00B7}  Ctrl+Alt+Enter")),
+            shown: false,
+            dwell: 0,
+            hover: None,
+            pressed: None,
+            tracking: false,
+        });
+    });
+    // SAFETY: the bar's window, just made on this thread.
+    unsafe { SetTimer(hwnd, 1, TICK_MS, std::ptr::null()) };
+}
+
+/// Closes the bar of SDL's window `owner`, where it has one.
+pub(crate) fn close(owner: HWND) {
+    let bar = BARS.with(|bars| {
+        let mut bars = bars.borrow_mut();
+        let at = bars.iter().position(|bar| bar.owner == owner as isize)?;
+        Some(bars.remove(at))
+    });
+    if let Some(bar) = bar {
+        // SAFETY: the bar's window, made on this thread, with its timer.
+        unsafe {
+            KillTimer(bar.hwnd as HWND, 1);
+            DestroyWindow(bar.hwnd as HWND);
+        }
+    }
+}
+
+/// The bar's window procedure.
+unsafe extern "system" fn window_proc(
+    hwnd: HWND,
+    message: u32,
+    wparam: usize,
+    lparam: isize,
+) -> isize {
+    match message {
+        WM_TIMER => {
+            tick(hwnd);
+            0
+        }
+        WM_MOUSEACTIVATE => MA_NOACTIVATE,
+        WM_ERASEBKGND => 1,
+        WM_PAINT => {
+            paint(hwnd);
+            0
+        }
+        WM_MOUSEMOVE => {
+            pointer(hwnd, Some(lparam as i32 & 0xFFFF));
+            0
+        }
+        WM_MOUSELEAVE => {
+            pointer(hwnd, None);
+            0
+        }
+        WM_LBUTTONDOWN => {
+            let hover = bar_of(hwnd).and_then(|bar| bar.hover);
+            change(hwnd, |bar| bar.pressed = hover);
+            repaint(hwnd);
+            0
+        }
+        WM_LBUTTONUP => {
+            if let Some(bar) = bar_of(hwnd) {
+                change(hwnd, |bar| bar.pressed = None);
+                repaint(hwnd);
+                if let Some(asked) = bar.pressed.filter(|&pressed| bar.hover == Some(pressed)) {
+                    crate::native::sdl_thread::sdl::bar_asked(bar.window, asked);
+                }
+            }
+            0
+        }
+        // SAFETY: the message is passed on as it came.
+        _ => unsafe { DefWindowProcW(hwnd, message, wparam, lparam) },
+    }
+}
+
+/// The bar is drawn again.
+fn repaint(hwnd: HWND) {
+    // SAFETY: the bar's window, on its thread; a null rectangle is the whole of it.
+    unsafe { InvalidateRect(hwnd, std::ptr::null(), 0) };
+}
+
+/// The pointer is over the bar at `x` pixels from its left, or has left it (`None`).
+fn pointer(hwnd: HWND, x: Option<i32>) {
+    let Some(bar) = bar_of(hwnd) else {
+        return;
+    };
+    // SAFETY: the bar's owner is SDL's window, on this thread.
+    let sizes = sizes(unsafe { GetDpiForWindow(bar.owner as HWND) });
+    let hover = x.and_then(|x| button_at(x, sizes));
+    if x.is_some() && !bar.tracking {
+        let mut track = TRACKMOUSEEVENT {
+            cbSize: size_of::<TRACKMOUSEEVENT>() as u32,
+            dwFlags: TME_LEAVE,
+            hwndTrack: hwnd,
+            dwHoverTime: 0,
+        };
+        // SAFETY: the structure is valid for the call.
+        unsafe { TrackMouseEvent(&mut track) };
+    }
+    change(hwnd, |bar| {
+        bar.hover = hover;
+        bar.tracking = x.is_some();
+        if x.is_none() {
+            bar.pressed = None;
+        }
+    });
+    if hover != bar.hover || x.is_none() {
+        repaint(hwnd);
+    }
+}
+
+/// One tick of the bar's timer: it shows or hides as the pointer's place says (the module doc).
+fn tick(hwnd: HWND) {
+    let Some(bar) = bar_of(hwnd) else {
+        return;
+    };
+    let owner = bar.owner as HWND;
+    let (mut screen, mut at) = (RECT::default(), POINT::default());
+    // SAFETY: the owner is SDL's window, on this thread; both structures are valid for the calls.
+    let (known, front, dpi) = unsafe {
+        (
+            GetWindowRect(owner, &mut screen) != 0 && GetCursorPos(&mut at) != 0,
+            GetForegroundWindow() == owner && IsIconic(owner) == 0,
+            GetDpiForWindow(owner),
+        )
+    };
+    let sizes = sizes(dpi);
+    let place = place(screen, sizes);
+    let margin = MARGIN * dpi.max(96) as i32 / 96;
+    let reach = known && in_reach(at, place, bar.shown, margin);
+    let (dwell, shows) = tick_step(bar.dwell, bar.shown, reach, front);
+    change(hwnd, |bar| {
+        bar.dwell = dwell;
+        if let Some(shows) = shows {
+            bar.shown = shows;
+            if !shows {
+                bar.hover = None;
+                bar.pressed = None;
+            }
+        }
+    });
+    match shows {
+        // SAFETY: the bar's window, on its thread; a null window to go after is the top.
+        Some(true) => unsafe {
+            SetWindowPos(
+                hwnd,
+                std::ptr::null_mut(),
+                place.left,
+                place.top,
+                sizes.width,
+                sizes.height,
+                SWP_NOACTIVATE | SWP_SHOWWINDOW,
+            );
+        },
+        // SAFETY: as above.
+        Some(false) => unsafe {
+            ShowWindow(hwnd, SW_HIDE);
+        },
+        None => {}
+    }
+}
+
+/// Paints the bar: its label, then its two buttons.
+fn paint(hwnd: HWND) {
+    // SAFETY: an all-zero paint structure is a valid one for Windows to fill.
+    let mut paint: PAINTSTRUCT = unsafe { std::mem::zeroed() };
+    // SAFETY: the bar's window, on its thread, in answer to `WM_PAINT`.
+    let dc = unsafe { BeginPaint(hwnd, &mut paint) };
+    if let Some(bar) = bar_of(hwnd).filter(|_| !dc.is_null()) {
+        // SAFETY: the bar's owner is SDL's window, on this thread.
+        let dpi = unsafe { GetDpiForWindow(bar.owner as HWND) };
+        let sizes = sizes(dpi);
+        let points = |points: i32| -(points * dpi.max(96) as i32 / 72);
+        let font = |points_high: i32, face: &str| {
+            let face = wide(face);
+            // SAFETY: the face's name is valid for the call, which copies it.
+            unsafe {
+                CreateFontW(
+                    points(points_high),
+                    0,
+                    0,
+                    0,
+                    400,
+                    0,
+                    0,
+                    0,
+                    DEFAULT_CHARSET,
+                    0,
+                    0,
+                    CLEARTYPE_QUALITY,
+                    0,
+                    face.as_ptr(),
+                )
+            }
+        };
+        let fill = |rect: RECT, color: u32| {
+            // SAFETY: the device context is the paint's; the brush is made and freed here.
+            unsafe {
+                let brush = CreateSolidBrush(color);
+                FillRect(dc, &rect, brush);
+                DeleteObject(brush);
+            }
+        };
+        let mut client = RECT::default();
+        // SAFETY: the bar's window; the rectangle is valid for the call.
+        unsafe { GetClientRect(hwnd, &mut client) };
+        fill(client, BACK);
+        let (text_font, glyph_font) = (font(9, "Segoe UI"), font(8, "Segoe MDL2 Assets"));
+        // SAFETY: the device context is the paint's.
+        let before = unsafe {
+            SetBkMode(dc, TRANSPARENT);
+            SetTextColor(dc, TEXT);
+            SelectObject(dc, text_font)
+        };
+        let mut label = RECT {
+            left: sizes.pad,
+            right: sizes.label,
+            ..client
+        };
+        let length = bar.label.len().saturating_sub(1) as i32;
+        // SAFETY: the label's `length` units are valid for the call.
+        unsafe {
+            DrawTextW(
+                dc,
+                bar.label.as_ptr(),
+                length,
+                &mut label,
+                DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS,
+            );
+            SelectObject(dc, glyph_font);
+        }
+        let buttons = [
+            (Asked::Minimize, GLYPH_MINIMIZE),
+            (Asked::Windowed, GLYPH_WINDOWED),
+        ];
+        for (index, (asked, glyph)) in buttons.into_iter().enumerate() {
+            let left = sizes.label + index as i32 * sizes.button;
+            let mut rect = RECT {
+                left,
+                right: left + sizes.button,
+                ..client
+            };
+            if bar.pressed == Some(asked) && bar.hover == Some(asked) {
+                fill(rect, PRESSED);
+            } else if bar.hover == Some(asked) {
+                fill(rect, HOVER);
+            }
+            // SAFETY: one unit, valid for the call.
+            unsafe {
+                DrawTextW(
+                    dc,
+                    &glyph,
+                    1,
+                    &mut rect,
+                    DT_SINGLELINE | DT_VCENTER | DT_CENTER | DT_NOPREFIX,
+                );
+            }
+        }
+        // SAFETY: the fonts are made above and selected out before they are freed.
+        unsafe {
+            SelectObject(dc, before);
+            DeleteObject(text_font);
+            DeleteObject(glyph_font);
+        }
+    }
+    // SAFETY: the paint begun above ends.
+    unsafe { EndPaint(hwnd, &paint) };
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A 2560 x 1600 screen at 150%.
+    const SCREEN: RECT = RECT {
+        left: 0,
+        top: 0,
+        right: 2560,
+        bottom: 1600,
+    };
+
+    /// The bar is centred at the top of its window's screen, at the screen's scale
+    #[test]
+    fn the_bar_is_centred_at_the_screen_s_top() {
+        let sizes = sizes(144);
+        assert_eq!((sizes.width, sizes.height), (507, 45));
+        let bar = place(SCREEN, sizes);
+        assert_eq!((bar.left, bar.top, bar.right, bar.bottom), (1026, 0, 1533, 45));
+        // A second screen left of the main one, and above it.
+        let other = RECT {
+            left: -1920,
+            top: -200,
+            right: 0,
+            bottom: 880,
+        };
+        let bar = place(other, super::sizes(96));
+        assert_eq!((bar.left, bar.top), (-1920 + (1920 - 338) / 2, -200));
+    }
+
+    /// Hidden, only the top rows within the bar's width show it; shown, the pointer near it
+    /// keeps it
+    #[test]
+    fn the_pointer_shows_the_bar_from_the_top_edge_over_it_only() {
+        let bar = place(SCREEN, sizes(96));
+        let at = |x, y| POINT { x, y };
+        assert!(in_reach(at(1280, 0), bar, false, 12));
+        assert!(in_reach(at(bar.left, 1), bar, false, 12));
+        assert!(!in_reach(at(1280, 2), bar, false, 12), "below the edge");
+        assert!(!in_reach(at(bar.left - 1, 0), bar, false, 12), "left of it");
+        assert!(!in_reach(at(40, 0), bar, false, 12), "the guest's menus");
+        assert!(in_reach(at(1280, bar.bottom + 11), bar, true, 12));
+        assert!(in_reach(at(bar.left - 12, 5), bar, true, 12));
+        assert!(!in_reach(at(1280, bar.bottom + 12), bar, true, 12));
+    }
+
+    /// The bar shows after a quarter second at the edge, hides 0.6 s after the pointer left,
+    /// and at once when its window is no longer in front
+    #[test]
+    fn the_bar_shows_after_a_rest_and_hides_after_the_pointer_left() {
+        let mut dwell = 0;
+        for _ in 0..SHOW_TICKS - 1 {
+            let (next, shows) = tick_step(dwell, false, true, true);
+            assert_eq!(shows, None);
+            dwell = next;
+        }
+        assert_eq!(tick_step(dwell, false, true, true), (0, Some(true)));
+        // A pass over the edge counts for nothing once the pointer is gone.
+        assert_eq!(tick_step(3, false, false, true), (0, None));
+        let mut dwell = 0;
+        for _ in 0..HIDE_TICKS - 1 {
+            let (next, shows) = tick_step(dwell, true, false, true);
+            assert_eq!(shows, None);
+            dwell = next;
+        }
+        assert_eq!(tick_step(dwell, true, false, true), (0, Some(false)));
+        assert_eq!(tick_step(5, true, true, true), (0, None), "back on the bar");
+        assert_eq!(tick_step(0, true, true, false), (0, Some(false)));
+        assert_eq!(tick_step(0, false, true, false), (0, None));
+    }
+
+    /// The two buttons are right of the label, minimize first
+    #[test]
+    fn the_buttons_are_right_of_the_label() {
+        let sizes = sizes(96);
+        assert_eq!(button_at(0, sizes), None);
+        assert_eq!(button_at(249, sizes), None);
+        assert_eq!(button_at(250, sizes), Some(Asked::Minimize));
+        assert_eq!(button_at(293, sizes), Some(Asked::Minimize));
+        assert_eq!(button_at(294, sizes), Some(Asked::Windowed));
+        assert_eq!(button_at(337, sizes), Some(Asked::Windowed));
+        assert_eq!(button_at(338, sizes), None);
+    }
+}
