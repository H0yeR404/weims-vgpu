+            target: "reims_vgpu_window",
+            "window {:?}: {} at the person's wish",
+            shell.window.title(),
+            if full { "full screen" } else { "a window again" }
+        );
+    } else {
+        shell::refused(
+            if full {
+                "no full screen"
+            } else {
+                "no way out of full screen"
+            },
+            shell.window.title(),
+        );
+    }
