      <TextBlock x:Name="UpdateChannel" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
      <TextBlock Text="{DynamicResource UpdateHelp}" Style="{StaticResource Hint}"/>
      <WrapPanel Margin="0,18,0,12">
       <Button Content="{DynamicResource UpdateCheck}" Click="CheckUpdates" IsEnabled="{Binding Available}"/>
       <Button x:Name="InstallUpdateButton" Content="{DynamicResource UpdateInstall}" Click="InstallUpdate" Margin="8,0,0,0" IsEnabled="False" Style="{StaticResource Primary}"/>
       <Button x:Name="CancelUpdateButton" Content="{DynamicResource S75}" Click="CancelUpdate" Margin="8,0,0,0" IsEnabled="False"/>
      </WrapPanel>
      <ProgressBar x:Name="UpdateProgress" Height="5" Minimum="0" Maximum="100"/>
      <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel></Border>
     <TextBlock Text="{DynamicResource UpdateNotes}" Style="{StaticResource Section}"/>
     <TextBox x:Name="ReleaseNotes" IsReadOnly="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="300" VerticalScrollBarVisibility="Auto"/>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   </DockPanel>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Card}" Padding="28,12"><DockPanel><Button Content="{DynamicResource S93}" DockPanel.Dock="Right" Click="RefreshState" Padding="12,4" MinHeight="28"/><StackPanel Margin="0,0,16,0"><ProgressBar Height="3" IsIndeterminate="{Binding Busy}" Margin="0,0,0,6"/><TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/></StackPanel></DockPanel></Border>
  </Grid>
 </Grid></Border>
</Window>
