<Window x:Class="Weims.Manager.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource S94}" Width="800" Height="780" MinWidth="700" MinHeight="620" WindowStartupLocation="CenterOwner">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{DynamicResource S95}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource S96}" Style="{StaticResource Hint}" Margin="0,4,0,18"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Form">
   <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{DynamicResource S97}" FontWeight="SemiBold" FontSize="16"/>
    <Label Content="{DynamicResource S98}" Target="{Binding ElementName=VmName}" Margin="0,12,0,0"/><TextBox x:Name="VmName" Text="macOS-Tahoe"/>
    <Label Content="{DynamicResource S99}" Target="{Binding ElementName=ImagePath}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource S80}" Tag="image" Click="Browse" Margin="8,0,0,0"/><TextBox x:Name="ImagePath"/></DockPanel>
    <Label Content="{DynamicResource S100}" Target="{Binding ElementName=ParentPath}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource S80}" Tag="folder" Click="Browse" Margin="8,0,0,0"/><TextBox x:Name="ParentPath"/></DockPanel>
    <Label Content="{DynamicResource S101}" Target="{Binding ElementName=DiskSize}"/><TextBox x:Name="DiskSize" Text="200"/>
   </StackPanel></Border>
   <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{DynamicResource S102}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{DynamicResource S103}" Style="{StaticResource Hint}"/>
    <Label Content="{DynamicResource S104}" Target="{Binding ElementName=OpenCorePath}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource S80}" Tag="opencore" Click="Browse" Margin="8,0,0,0"/><TextBox x:Name="OpenCorePath"/></DockPanel>
    <Label Content="OVMF_CODE.fd" Target="{Binding ElementName=CodePath}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource S80}" Tag="code" Click="Browse" Margin="8,0,0,0"/><TextBox x:Name="CodePath"/></DockPanel>
    <Label Content="{DynamicResource S105}" Target="{Binding ElementName=VarsPath}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource S80}" Tag="vars" Click="Browse" Margin="8,0,0,0"/><TextBox x:Name="VarsPath"/></DockPanel>
    <Label Content="ReimsGraphics.rom" Target="{Binding ElementName=RomPath}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource S80}" Tag="rom" Click="Browse" Margin="8,0,0,0"/><TextBox x:Name="RomPath"/></DockPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{DynamicResource S106}" FontWeight="SemiBold"/><Label Content="{DynamicResource S107}" Target="{Binding ElementName=QmpPort}"/><TextBox x:Name="QmpPort" Text="4455"/><Label Content="{DynamicResource S108}" Target="{Binding ElementName=SshPort}"/><TextBox x:Name="SshPort" Text="2233"/><TextBlock Text="{DynamicResource S109}" Style="{StaticResource Hint}"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><ProgressBar x:Name="Progress" Height="3"/><TextBlock x:Name="Status" Text="{DynamicResource S110}" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/><DockPanel Margin="0,12,0,0"><Button x:Name="CreateButton" DockPanel.Dock="Right" Content="{DynamicResource S27}" Style="{StaticResource Primary}" Click="Create"/><Button x:Name="CancelButton" Content="{DynamicResource S75}" HorizontalAlignment="Left" Click="Cancel"/></DockPanel></StackPanel>
 </Grid>
</Window>
