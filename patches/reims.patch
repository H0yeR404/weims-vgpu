+//! The OS services on Windows: the clocks ([`WindowsClock`]), threads ([`WindowsThreads`]), Mach
+//! VM's calls over sections and placeholders ([`WindowsVm`]), whose views of the guest's pages
+//! map the sections the backing table names (`backing`), IOSurface's stand-in over that memory
+//! ([`WindowsSurface`]), what the runtime imports for host memory (`import`), and what the window
+//! system's Vulkan extensions take here (`crate::os`'s `wsi`: the surface extension and the
+//! loader). No Objective-C runs here: core pushes no autorelease pool where none is installed.
+//!
+//! What Linux's services have and these do not, as Windows has no counterpart: dma-bufs of host
+//! pages and a device's copies of another driver's planes in them, the guest's RAM handed whole
+//! to a device, and a budget of kernel mappings (`os/linux.rs`).
+
+mod api;
+mod backing;
+mod clock;
+mod import;
+mod surface;
+mod threads;
+mod vm;
+
+use std::ffi::CStr;
+
+use ash::vk;
+use metal2vulkan_runtime as rt;
+
+pub use backing::{GuestMemoryLease, lease_guest_memory};
+pub use clock::WindowsClock;
+pub use surface::{WindowsSurface, WindowsSurfaces};
+pub use threads::WindowsThreads;
+pub use vm::{RegionMemory, WindowsVm};
+
+pub(crate) use import::{
+    COPIES_READ_ONLY, ImportView, TWINS_READ_ONLY, allocate_zeros, dma_buf_refusal, host_memory,
+    host_memory_vouched, import_view, shown_at,
+};
+pub(crate) use surface::{
+    own_alias, plane_at, plane_shape, recorded_mut, surface_memory_hold, ycbcr_matrix,
+};
+pub(crate) use vm::allocate_aliasable;
+#[cfg(test)]
+pub(crate) use vm::tests::{PAGE, mapped, writable};
+
+/// The instance's surface extension a display's window presents over, besides `VK_KHR_surface`,
+/// asked for where the loader lists it (`crate::os`'s `wsi`): `VK_KHR_win32_surface`, over the
+/// window's `HWND`.
+pub(crate) const WINDOW_SURFACE_EXTENSIONS: [&CStr; 1] = [ash::khr::win32_surface::NAME];
+
+/// The device extensions a window's swapchain needs besides `VK_KHR_swapchain`: none.
+pub(crate) const WINDOW_DEVICE_EXTENSIONS: [&CStr; 0] = [];
+
+/// The Vulkan loader, opened by its usual name (`vulkan-1.dll`), as the runtime opens it.
+pub(crate) fn open_loader() -> Result<ash::Entry, ash::LoadingError> {
+    // SAFETY: opening the loader runs its initialization, and it is kept open while the entry
+    // lives.
+    unsafe { ash::Entry::load() }
+}
+
+/// What fetches a swapchain image's drawable ahead of its frame: nothing here, where an image's
+/// memory is the driver's own once it is acquired (`crate::swapchain`).
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum Drawables {}
+
+impl Drawables {
+    /// None on Windows.
+    pub(crate) fn load(_raw: &rt::Device) -> Option<Drawables> {
+        None
+    }
+
+    /// Never called: there is no value.
+    ///
+    /// # Safety
+    ///
+    /// None needed.
+    pub(crate) unsafe fn fetch(&self, _image: vk::Image) -> bool {
+        match *self {}
+    }
+}
+
+/// The clocks.
+pub type OsClock = WindowsClock;
+/// The threads.
+pub type OsThreads = WindowsThreads;
+/// Mach VM's calls.
+pub type OsVm = WindowsVm;
+/// An IOSurface: the stand-in's, one reference.
+pub type OsSurface = WindowsSurface;
+/// IOSurface creation: the stand-in's.
+pub type OsSurfaces = WindowsSurfaces;
+
+/// Installs what the process's platform needs before it runs: nothing on Windows, where a
+/// section's handle counts against no limit a process raises (Linux's open files), and no
+/// Objective-C runs.
+pub fn install_process_services() {}
+
+/// The registry ID the platform answers for the runtime's default device in place of its own:
+/// none, as there is no Metal here to ask, so the runtime's own stands.
+pub fn default_registry_id() -> Option<u64> {
