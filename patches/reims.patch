+            SurfaceSpec {
+                alloc_size: physical_memory() + 1,
+                ..host_only()
+            },
+        ];
+        for spec in refused {
+            assert!(surfaces.create(&spec).is_none(), "{spec:?}");
+        }
+        let made = [
+            SurfaceSpec {
+                offset: 0x40,
+                alloc_size: 1088,
+                ..host_only()
+            },
+            SurfaceSpec {
+                bytes_per_row: 100,
+                alloc_size: 1564,
+                ..host_only()
+            },
+            // 4 × 4 blocks of 8 bytes: 5 blocks a row, 5 rows.
+            SurfaceSpec {
+                width: 17,
+                height: 17,
+                element_width: 4,
+                element_height: 4,
+                bytes_per_element: 8,
+                bytes_per_row: 40,
+                alloc_size: 200,
+                ..host_only()
+            },
+            SurfaceSpec {
+                client_direction: Some(3),
+                ..host_only()
