diff --git a/crates/reims-vgpu-graphics/src/wake_windows.rs b/crates/reims-vgpu-graphics/src/wake_windows.rs
new file mode 100644
index 000000000..141e20539
--- /dev/null
+++ b/crates/reims-vgpu-graphics/src/wake_windows.rs
@@ -0,0 +1,91 @@
+//! How the control thread sleeps on Windows: on [`Wake`], a flag and a condition variable of the
+//! device's own, which a doorbell written through the device's MMIO, the guest's `STATUS` and
+//! the device's end set. A Windows host gives no doorbell file: WHPX has no in-kernel ioeventfd,
+//! so every `DOORBELL` write reaches the device through its MMIO path and wakes it there.
+
+use parking_lot::{Condvar, Mutex};
+
+/// A host's doorbell as it names it. No Windows host has one.
+pub(crate) type RawDoorbell = i32;
+
+/// The device's copy of a host's doorbell. None exists on Windows.
+#[derive(Debug)]
+pub(crate) enum Doorbell {}
+
+/// The name [`Wake::sleep`] takes for `doorbell`.
+pub(crate) fn raw(doorbell: &Doorbell) -> RawDoorbell {
+    match *doorbell {}
+}
+
+/// The device's own wake.
+#[derive(Debug)]
+pub(crate) struct Wake {
+    /// Whether a wake is pending.
+    pending: Mutex<State>,
+    woken: Condvar,
+}
+
+#[derive(Debug, Default)]
+struct State {
+    pending: bool,
+    /// Whether the thread that sleeps on it is in its sleep ([`Wake::parked`]).
+    sleeping: bool,
+}
+
+impl Wake {
+    /// A new wake, with none pending.
+    #[expect(
+        clippy::unnecessary_wraps,
+        reason = "the Unix wake is a pipe the host may refuse"
+    )]
+    pub(crate) fn new() -> Option<Wake> {
+        Some(Wake {
+            pending: Mutex::new(State::default()),
+            woken: Condvar::new(),
+        })
+    }
+
+    /// Whether the thread that sleeps on it is in its sleep with no wake pending.
+    #[cfg(test)]
+    pub(crate) fn parked(&self, _doorbell: Option<RawDoorbell>) -> bool {
+        let state = self.pending.lock();
+        state.sleeping && !state.pending
+    }
+
+    /// Wakes the control thread. A wake already pending stays the one wake.
+    pub(crate) fn wake(&self) {
+        self.pending.lock().pending = true;
+        self.woken.notify_one();
+    }
+
+    /// Sleeps until a wake, then takes it.
+    pub(crate) fn sleep(&self, _doorbell: Option<RawDoorbell>) {
+        let mut state = self.pending.lock();
+        state.sleeping = true;
+        while !state.pending {
+            self.woken.wait(&mut state);
+        }
+        state.sleeping = false;
+        state.pending = false;
+    }
+}
+
+/// A copy of the host's doorbell: none on Windows.
+pub(crate) fn duplicate(_doorbell: RawDoorbell) -> Option<Doorbell> {
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A wake ends a sleep, and one sent while awake ends the next sleep once
+    #[test]
+    fn a_wake_ends_a_sleep() {
+        let wake = Wake::new().unwrap();
+        wake.wake();
+        wake.wake();
+        wake.sleep(None);
+        assert!(!wake.pending.lock().pending);
+    }
+}
