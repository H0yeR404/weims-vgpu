+        assert_eq!(read(dst, PAGE + 5), 7, "the source's second page");
+        write(dst, PAGE + 6, 9);
+        assert_eq!(read(src, PAGE + 6), 9);
+        write(src, PAGE + 7, 11);
+        assert_eq!(read(dst, PAGE + 7), 11);
+        assert_eq!((read(dst, 0), read(dst, 2 * PAGE)), (0x33, 0), "its others");
+        assert!(v.deallocate(src, 3 * PAGE).is_success());
+        assert_eq!(read(dst, PAGE + 6), 9, "the alias keeps the pages");
+        // A view of the view shows them too.
+        let again = v.allocate_anywhere(PAGE).unwrap();
+        v.remap_shared_overwrite(again, dst.wrapping_add(PAGE), PAGE)
+            .unwrap();
+        assert_eq!(read(again, 7), 11);
+        for (at, pages) in [(dst, 3), (again, 1)] {
+            assert!(v.deallocate(at, pages * PAGE).is_success());
+        }
+    }
+
+    /// A remap of no bytes is an invalid argument, and one of a source no section is behind an
+    /// invalid address, which changes nothing of its target
+    #[test]
+    fn a_refused_remap_changes_nothing() {
+        let v = vm();
+        let dst = v.allocate_anywhere(2 * PAGE).unwrap();
+        write(dst, 0, 4);
+        write(dst, PAGE, 5);
+        assert_eq!(
+            v.remap_shared_overwrite(dst, dst.wrapping_add(PAGE), 0),
+            Err(INVALID_ARGUMENT)
+        );
+        let nowhere = HostAddr::from_addr(0x1000);
+        assert_eq!(
+            v.remap_shared_overwrite(dst, nowhere, PAGE),
+            Err(INVALID_ADDRESS)
+        );
+        // A source that runs past what the library mapped: its second page has no section.
+        let src = v.allocate_anywhere(PAGE).unwrap();
+        assert_eq!(
+            v.remap_shared_overwrite(dst, src, 2 * PAGE),
+            Err(INVALID_ADDRESS)
+        );
+        assert_eq!((read(dst, 0), read(dst, PAGE)), (4, 5));
+        assert_eq!(views_and_runs(dst, 2), (1, 1));
+        for (at, pages) in [(dst, 2), (src, 1)] {
+            assert!(v.deallocate(at, pages * PAGE).is_success());
+        }
+    }
+
+    /// A protect makes its pages read-only and cuts no view; the protection is a maximum, never
+    /// raised again; a view of read-only pages is read-only, though the source's other pages
+    /// stay writable; and none makes a page unreadable
+    #[test]
+    fn a_protect_lowers_a_pages_protection_for_good() {
+        let v = vm();
+        let a = v.allocate_anywhere(4 * PAGE).unwrap();
+        write(a, PAGE, 0x21);
+        v.protect_max(a.wrapping_add(PAGE + 1), PAGE, VmProt::READ)
+            .unwrap();
+        let now: Vec<bool> = (0..4)
+            .map(|i| writable(a.wrapping_add(i * PAGE), PAGE))
+            .collect();
+        assert_eq!(now, [true, false, false, true]);
+        assert_eq!(read(a, PAGE), 0x21, "still read");
+        assert_eq!(views_and_runs(a, 4), (1, 3), "one view, cut in the table");
+        assert_eq!(
+            kernel_regions(a, 4),
+            [
+                (0, api::MEM_COMMIT, api::PAGE_READWRITE),
+                (1, api::MEM_COMMIT, api::PAGE_READONLY),
+                (3, api::MEM_COMMIT, api::PAGE_READWRITE)
+            ]
+        );
+        assert_eq!(
+            v.protect_max(a, 4 * PAGE, VmProt::READ | VmProt::WRITE),
+            Err(PROTECTION_FAILURE),
+            "never raised"
+        );
+        v.protect_max(a.wrapping_add(PAGE), 2 * PAGE, VmProt::READ)
+            .unwrap();
+        v.protect_max(a, PAGE, VmProt::READ | VmProt::WRITE)
+            .unwrap();
+        assert!(v.readable(a, 4 * PAGE));
+        assert_eq!(files::writable(a.addr().to_u64(), 4 * PAGE), Some(false));
+        // A view of the second and fourth pages: read-only and writable, as they are.
+        let view = v.allocate_anywhere(2 * PAGE).unwrap();
+        let runs = [
+            (a.wrapping_add(PAGE), PAGE),
+            (a.wrapping_add(3 * PAGE), PAGE),
+        ];
+        v.remap_runs_shared_overwrite(view, &runs).unwrap();
+        assert_eq!(
+            [
+                writable(view, PAGE),
+                writable(view.wrapping_add(PAGE), PAGE)
+            ],
+            [false, true]
+        );
+        assert_eq!(read(view, 0), 0x21);
+        v.protect_max(a.wrapping_add(3 * PAGE), PAGE, VmProt::NONE)
+            .unwrap();
+        assert!(!v.readable(a, 4 * PAGE) && v.readable(a, 3 * PAGE));
+        assert!(mapped(a.wrapping_add(3 * PAGE)), "mapped, with no access");
+        assert_eq!(
+            v.protect_max(view.wrapping_add(2 * PAGE), PAGE, VmProt::READ),
+            Err(INVALID_ADDRESS),
+            "pages the library does not map"
+        );
+        for (at, pages) in [(a, 4), (view, 2)] {
+            assert!(v.deallocate(at, pages * PAGE).is_success());
+        }
+    }
+
+    /// A view of several runs made at once shows each in its place, each stretch that follows on
+    /// in a section one view of the kernel's, and a run with no section behind it is refused
+    /// with its index, the runs before it mapped
+    #[test]
+    fn runs_are_viewed_at_once() {
+        let v = vm();
+        let src = v.allocate_anywhere(4 * PAGE).unwrap();
+        for i in 0..4 {
+            write(src, i * PAGE, 0x40 + u8::try_from(i).unwrap());
+        }
+        let at = |i: u64| src.wrapping_add(i * PAGE);
+        let view = v.allocate_anywhere(4 * PAGE).unwrap();
+        // Pages 2 and 3, which follow on, then 1, then 0.
+        let runs = [(at(2), PAGE), (at(3), PAGE), (at(1), PAGE), (at(0), PAGE)];
+        v.remap_runs_shared_overwrite(view, &runs).unwrap();
+        let bytes: Vec<u8> = (0..4).map(|i| read(view, i * PAGE)).collect();
+        assert_eq!(bytes, [0x42, 0x43, 0x41, 0x40]);
+        assert_eq!(views_and_runs(view, 4), (3, 3));
+        write(view, 2 * PAGE + 1, 0x99);
+        assert_eq!(read(src, PAGE + 1), 0x99);
+        // The second run lies in nothing: the first is mapped, the rest as it was.
+        let other = v.allocate_anywhere(3 * PAGE).unwrap();
+        write(other, PAGE, 0x55);
+        let nowhere = HostAddr::from_addr(0x2000);
+        let refused = [(at(1), PAGE), (nowhere, PAGE), (at(2), PAGE)];
+        assert_eq!(
+            v.remap_runs_shared_overwrite(other, &refused),
+            Err((1, INVALID_ADDRESS))
+        );
+        assert_eq!((read(other, 0), read(other, PAGE)), (0x41, 0x55));
+        // Runs off their pages go one at a time, each as a remap takes it.
+        let off = [(at(0).wrapping_add(8), PAGE)];
+        v.remap_runs_shared_overwrite(other.wrapping_add(2 * PAGE), &off)
+            .unwrap();
+        assert_eq!(read(other, 2 * PAGE), 0x40);
+        for (at, pages) in [(src, 4), (view, 4), (other, 3)] {
+            assert!(v.deallocate(at, pages * PAGE).is_success());
+        }
+    }
+
+    /// A call over part of a view leaves the view's other pages the same pages: their bytes, and
+    /// an alias of them made before, still show each other's writes
+    #[test]
+    fn a_call_over_part_of_a_view_keeps_its_other_pages() {
+        let v = vm();
+        let a = v.allocate_anywhere(8 * PAGE).unwrap();
+        for i in 0..8 {
+            write(a, i * PAGE, u8::try_from(i).unwrap());
+        }
+        v.protect_max(a.wrapping_add(6 * PAGE), PAGE, VmProt::READ)
+            .unwrap();
+        let alias = v.allocate_anywhere(8 * PAGE).unwrap();
+        v.remap_shared_overwrite(alias, a, 8 * PAGE).unwrap();
+        v.allocate_fixed_overwrite(a.wrapping_add(3 * PAGE), PAGE)
+            .unwrap();
+        assert!(v.deallocate(a.wrapping_add(4 * PAGE), PAGE).is_success());
+        let bytes: Vec<u8> = [0, 1, 2, 3, 5, 6, 7]
+            .iter()
+            .map(|&i| read(a, i * PAGE))
+            .collect();
+        assert_eq!(bytes, [0, 1, 2, 0, 5, 6, 7]);
+        write(a, 2 * PAGE + 1, 0xaa);
+        write(alias, 5 * PAGE + 1, 0xbb);
+        assert_eq!(
+            (read(alias, 2 * PAGE + 1), read(a, 5 * PAGE + 1)),
+            (0xaa, 0xbb)
+        );
+        assert_eq!(
+            read(alias, 3 * PAGE),
+            3,
+            "the alias keeps the page overwritten"
+        );
+        let now: Vec<bool> = (5..8)
+            .map(|i| writable(a.wrapping_add(i * PAGE), PAGE))
+            .collect();
+        assert_eq!(now, [true, false, true], "the protections kept");
+        for at in [a, alias] {
+            assert!(v.deallocate(at, 8 * PAGE).is_success());
+        }
+    }
+
+    /// `readable` follows the table's protections, and the system's for memory the library did
+    /// not map
+    #[test]
+    fn readable_follows_the_protection() {
+        let v = vm();
+        let a = v.allocate_anywhere(2 * PAGE).unwrap();
+        assert!(v.readable(a, 2 * PAGE) && v.readable(a, 0));
+        v.protect_max(a.wrapping_add(PAGE), PAGE, VmProt::NONE)
+            .unwrap();
+        assert!(v.readable(a, PAGE) && !v.readable(a, 2 * PAGE));
+        assert!(v.deallocate(a, 2 * PAGE).is_success());
+        assert!(!v.readable(a, 1), "unmapped");
+        let mut local = [0u8; 16];
+        let stack = HostAddr::from_ptr(local.as_mut_ptr());
+        assert!(v.readable(stack, 16), "memory of the process's own");
+        assert!(!v.readable(HostAddr::from_addr(0x1000), 1));
+    }
+
+    /// Memory of the library's own is whole pages of zeros that a view can be made of, that no
+    /// deallocate of the VM's frees, and that goes with its holder
+    #[test]
+    fn own_memory_is_registered_until_its_holder_drops() {
+        let v = vm();
+        assert!(OwnMemory::new(0).is_none());
+        let memory = OwnMemory::new(PAGE + 1).unwrap();
+        let at = HostAddr::from_addr(memory.first().to_usize());
+        assert!(writable(at, 2 * PAGE));
+        assert!((0..2 * PAGE).all(|off| read(at, off) == 0));
+        assert_eq!(v.deallocate(at, 2 * PAGE), INVALID_ARGUMENT);
+        assert!(mapped(at));
+        write(at, PAGE, 0x6c);
+        let view = v.allocate_anywhere(PAGE).unwrap();
+        v.remap_shared_overwrite(view, at.wrapping_add(PAGE), PAGE)
+            .unwrap();
+        assert_eq!(read(view, 0), 0x6c);
+        drop(memory);
+        assert!(!mapped(at));
+        assert_eq!(read(view, 0), 0x6c, "the view keeps the page");
+        assert!(v.deallocate(view, PAGE).is_success());
+    }
+
+    /// Memory of the library's own whose pages a device's import holds stays mapped past its
+    /// drop, until the import's hold goes, as a region's whose last reference goes in a no-copy
+    /// buffer's deallocator, before the runtime frees the buffer's import
+    #[test]
+    fn own_memory_an_import_holds_is_unmapped_once_its_hold_goes() {
+        let memory = OwnMemory::new(2 * PAGE).unwrap();
+        let at = HostAddr::from_addr(memory.first().to_usize());
+        let held = at.wrapping_add(PAGE);
+        let hold = crate::remap::UnmapHold::new(
+            std::ptr::NonNull::new(held.as_ptr::<u8>()).unwrap(),
+            PAGE,
+        );
+        write(held, 0, 0x5a);
+        drop(memory);
+        assert!(crate::remap::unmap_waits(at, 2 * PAGE), "the unmap waits");
+        assert_eq!(read(held, 0), 0x5a, "the held page stays mapped");
+        drop(hold);
+        assert!(!crate::remap::unmap_waits(at, 2 * PAGE), "unmapped");
+        assert!(!mapped(held));
+    }
+
+    /// A region is whole pages of zeros, page-aligned, read and write, and none for no bytes
+    #[test]
+    fn a_region_is_whole_pages_of_zeros() {
+        assert!(RegionMemory::new(0).is_none());
+        let len = 16 * PAGE + 1;
+        let memory = RegionMemory::new(len).unwrap();
+        let at = HostAddr::from_ptr(memory.base());
+        assert_eq!(at.addr().to_u64() % PAGE, 0, "page-aligned");
+        assert!(writable(at, 17 * PAGE));
+        assert!((0..17 * PAGE).all(|off| read(at, off) == 0));
+        write(at, len - 1, 3);
+        assert_eq!(read(at, len - 1), 3);
+        drop(memory);
+        assert!(!mapped(at));
+    }
+
+    /// A deallocate of many views goes a stretch at a time, and frees them all
+    #[test]
+    fn a_deallocate_of_many_views_frees_them_all() {
+        let v = vm();
+        let count = 2 * DEALLOCATE_RUNS.to_u64() + 3;
+        let src = v.allocate_anywhere(3 * PAGE).unwrap();
+        let view = v.allocate_anywhere(count * PAGE).unwrap();
+        // The source's three pages backwards in turn: no two neighbours follow on, so each is a
+        // view.
+        let runs: Vec<_> = (0..count)
+            .map(|i| (src.wrapping_add((2 - i % 3) * PAGE), PAGE))
+            .collect();
+        v.remap_runs_shared_overwrite(view, &runs).unwrap();
+        let views = usize::try_from(count).unwrap();
+        assert_eq!(views_and_runs(view, count), (views, views));
+        write(src, 0, 0x12);
+        assert_eq!(read(view, 2 * PAGE), 0x12);
+        assert_eq!(read(view, (count - 3) * PAGE), 0x12);
+        assert!(v.deallocate(view, count * PAGE).is_success());
+        assert_eq!(views_and_runs(view, count), (0, 0));
+        assert!((0..count).all(|i| !mapped(view.wrapping_add(i * PAGE))));
+        assert!(v.deallocate(src, 3 * PAGE).is_success());
+    }
+
+    /// The guest's RAM the host maps itself, leased by its section, is viewed a page at a time
+    /// in any order, each from its own offset in the section: the view and the RAM show each
+    /// other's writes; no deallocate of the VM's unmaps the RAM; and once the lease goes no view
+    /// of the RAM is made, while the views made keep its pages
+    #[test]
+    fn leased_ram_is_viewed_from_its_section() {
+        let v = vm();
+        // A plain view takes whole 64 KiB granules.
+        let length = 16 * PAGE;
+        let file = section(length).unwrap();
+        // SAFETY: a view of a section this test holds, anywhere, over no placeholder, as a host
+        // maps its guest's RAM; unmapped below.
+        let mapped_at = unsafe {
+            api::MapViewOfFile3(
+                file.as_raw_handle(),
+                api::GetCurrentProcess(),
+                std::ptr::null_mut(),
+                0,
+                length.to_usize(),
+                0,
+                api::PAGE_READWRITE,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        assert!(!mapped_at.is_null());
+        let ram = HostAddr::from_ptr(mapped_at);
+        for i in 0..16 {
+            write(ram, i * PAGE, u8::try_from(i).unwrap());
+        }
+        let lease = files::lease_guest_memory([crate::os::GuestRamFile {
+            host: ram.addr().to_u64(),
+            guest: 0x1_0000_0000,
+            length,
+            handle: Arc::clone(&file),
+            offset: 0,
+        }]);
+        let at = |i: u64| ram.wrapping_add(i * PAGE);
+        let view = v.allocate_anywhere(3 * PAGE).unwrap();
+        v.remap_runs_shared_overwrite(view, &[(at(5), PAGE), (at(2), PAGE), (at(3), PAGE)])
+            .unwrap();
+        let bytes: Vec<u8> = (0..3).map(|i| read(view, i * PAGE)).collect();
+        assert_eq!(bytes, [5, 2, 3]);
+        assert_eq!(views_and_runs(view, 3), (2, 2), "pages 2 and 3 follow on");
+        write(view, PAGE + 1, 0xee);
+        write(ram, 5 * PAGE + 2, 0xdd);
+        assert_eq!((read(ram, 2 * PAGE + 1), read(view, 2)), (0xee, 0xdd));
+        assert!(v.readable(ram, length));
+        assert_eq!(v.deallocate(ram, length), INVALID_ARGUMENT);
+        assert_eq!(read(ram, 15 * PAGE), 15, "the RAM stays mapped");
+        drop(lease);
+        let other = v.allocate_anywhere(PAGE).unwrap();
+        assert_eq!(
+            v.remap_shared_overwrite(other, ram, PAGE),
+            Err(INVALID_ADDRESS),
+            "no lease, no section behind the RAM"
+        );
+        // SAFETY: the view of the RAM this test mapped, which nothing else names.
+        assert_ne!(
+            unsafe { api::UnmapViewOfFile2(api::GetCurrentProcess(), mapped_at, 0) },
+            0
+        );
+        assert_eq!(read(view, 0), 5, "the view keeps the pages");
+        for (at, pages) in [(view, 3), (other, 1)] {
+            assert!(v.deallocate(at, pages * PAGE).is_success());
+        }
+    }
+}
