+//! What the device asks of the host's OS: anonymous zeroed memory for the region, and the
+//! monotonic clock. Unix has them from `libc`; Windows from kernel32.
+
+#[cfg(unix)]
+mod imp {
+    /// `len` bytes of private anonymous memory, zeroed and committed as they are first touched;
+    /// `None` where the host refuses the mapping.
+    pub(crate) fn map_zeroed(len: usize) -> Option<*mut u8> {
+        // SAFETY: a fresh anonymous mapping, at an address the kernel picks.
+        let base = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        (base != libc::MAP_FAILED).then(|| base.cast::<u8>())
+    }
+
+    /// Unmaps what [`map_zeroed`] gave.
+    ///
+    /// # Safety
+    /// `base` and `len` are a mapping of [`map_zeroed`]'s that nothing reaches after this.
+    pub(crate) unsafe fn unmap(base: *mut u8, len: usize) {
+        // SAFETY: the caller's contract.
+        unsafe { libc::munmap(base.cast(), len) };
+    }
+
+    /// The host's monotonic clock, in nanoseconds.
+    pub(crate) fn mono_ns() -> u64 {
+        let mut ts = libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 0,
+        };
+        // SAFETY: `clock_gettime` writes the timespec.
+        unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) };
+        let secs = u64::try_from(ts.tv_sec).unwrap_or(0);
+        let nanos = u64::try_from(ts.tv_nsec).unwrap_or(0);
+        secs.saturating_mul(1_000_000_000).saturating_add(nanos)
+    }
+}
+
+#[cfg(windows)]
+mod imp {
+    use std::ffi::c_void;
+
+    const MEM_COMMIT: u32 = 0x1000;
+    const MEM_RESERVE: u32 = 0x2000;
+    const MEM_RELEASE: u32 = 0x8000;
+    const PAGE_READWRITE: u32 = 0x04;
+
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn VirtualAlloc(address: *mut c_void, size: usize, kind: u32, protect: u32) -> *mut c_void;
+        fn VirtualFree(address: *mut c_void, size: usize, kind: u32) -> i32;
+    }
+
+    // In api-ms-win-core-realtime-l1-1-1, which MinGW's onecore import library names.
+    #[link(name = "onecore")]
+    unsafe extern "system" {
+        fn QueryInterruptTimePrecise(time: *mut u64);
+    }
+
+    /// `len` bytes of private memory, zeroed, whose pages get physical memory as they are first
+    /// touched; `None` where the host refuses it. The whole length counts against the system's
+    /// commit limit from the start, which a Unix mapping's does not.
+    pub(crate) fn map_zeroed(len: usize) -> Option<*mut u8> {
+        // SAFETY: a fresh allocation, at an address the kernel picks.
+        let base = unsafe {
+            VirtualAlloc(
+                std::ptr::null_mut(),
+                len,
+                MEM_RESERVE | MEM_COMMIT,
+                PAGE_READWRITE,
+            )
+        };
+        (!base.is_null()).then(|| base.cast::<u8>())
+    }
+
+    /// Frees what [`map_zeroed`] gave.
+    ///
+    /// # Safety
+    /// `base` is an allocation of [`map_zeroed`]'s that nothing reaches after this.
+    pub(crate) unsafe fn unmap(base: *mut u8, _len: usize) {
+        // SAFETY: the caller's contract; a release names the allocation's base and no size.
+        unsafe { VirtualFree(base.cast(), 0, MEM_RELEASE) };
+    }
+
+    /// The host's monotonic clock, in nanoseconds: the interrupt time, which counts the time the
+    /// host sleeps and is the clock the library's platform reads (`reims_vgpu_vulkan::os`'s
+    /// `OsClock`). The device stamps a refresh with it and the platform a present, and the guest
+    /// places one against the other, so both must read one clock: the performance counter runs
+    /// at the same rate from another origin (0.8 s apart on the host this was written on).
+    pub(crate) fn mono_ns() -> u64 {
+        let mut ticks = 0u64;
+        // SAFETY: writes the one integer.
+        unsafe { QueryInterruptTimePrecise(&mut ticks) };
+        ticks.saturating_mul(100)
+    }
+}
+
+pub(crate) use imp::{map_zeroed, mono_ns, unmap};
