+/// CPU time in nanoseconds, on Windows: this thread's and the process's, kernel and user time
+/// together (`GetThreadTimes`, `GetProcessTimes`), and the unbiased interrupt time (wall).
+#[cfg(windows)]
+fn cpu_now() -> [u64; 3] {
+    use std::ffi::c_void;
+    /// `FILETIME`: 100 ns units, in two halves.
+    #[repr(C)]
+    #[derive(Clone, Copy, Default)]
+    struct FileTime {
+        low: u32,
+        high: u32,
+    }
+    /// `GetThreadTimes` and `GetProcessTimes`, which take the same arguments.
+    type Times = unsafe extern "system" fn(
+        *mut c_void,
+        *mut FileTime,
+        *mut FileTime,
+        *mut FileTime,
+        *mut FileTime,
+    ) -> i32;
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn GetCurrentThread() -> *mut c_void;
+        fn GetCurrentProcess() -> *mut c_void;
+        fn GetThreadTimes(
+            thread: *mut c_void,
+            creation: *mut FileTime,
+            exit: *mut FileTime,
+            kernel: *mut FileTime,
+            user: *mut FileTime,
+        ) -> i32;
+        fn GetProcessTimes(
+            process: *mut c_void,
+            creation: *mut FileTime,
+            exit: *mut FileTime,
+            kernel: *mut FileTime,
+            user: *mut FileTime,
+        ) -> i32;
+        fn QueryUnbiasedInterruptTime(time: *mut u64) -> i32;
+    }
+    let cpu = |times: Times, of: *mut c_void| {
+        let mut at = [FileTime::default(); 4];
+        let [creation, exit, kernel, user] = &mut at;
+        // SAFETY: a pseudo handle of the caller's own, and four `FILETIME`s the call writes.
+        assert_ne!(unsafe { times(of, creation, exit, kernel, user) }, 0);
+        let ticks = |t: FileTime| (u64::from(t.high) << 32) | u64::from(t.low);
+        (ticks(at[2]) + ticks(at[3])) * 100
+    };
+    let mut wall = 0u64;
+    // SAFETY: the calls answer pseudo handles and write the one value given.
+    let (thread, process) = unsafe {
+        assert_ne!(QueryUnbiasedInterruptTime(&mut wall), 0);
+        (GetCurrentThread(), GetCurrentProcess())
+    };
+    [
+        cpu(GetThreadTimes, thread),
+        cpu(GetProcessTimes, process),
+        wall * 100,
+    ]
+}
