+                super::super::backing::runs_between(view, view + length),
+                runs
+            );
+            assert_eq!(read(view + page), second);
+            drop(s);
+        }
+        free(at, 4 * page);
+    }
+
+    /// A surface over pages no section is behind is refused, nothing left mapped
+    #[test]
+    fn pages_without_a_section_are_refused() {
+        let page = page_size();
+        // Memory of the process's heap, which the library mapped none of: two whole pages of it.
+        let heap = vec![0u8; (3 * page).to_usize()];
+        let at = (heap.as_ptr().addr().to_u64()).next_multiple_of(page);
+        let ranges: Vec<_> = (0..2)
+            .map(|i| PhysicalMemoryRange {
+                physical_address: at + i * page,
+                physical_length: page,
