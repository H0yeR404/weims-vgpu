+//! exports of `kernelbase.dll` that `kernel32.dll` does not forward (Windows 10 1803 and later).
+//! MinGW-w64's `libkernel32.a` has none of them; its `libonecore.a` imports each from the API set
+//! that holds it (`api-ms-win-core-memory-l1-1-6.dll`, `api-ms-win-core-realtime-l1-1-1.dll`),
+//! which the loader resolves to `kernelbase.dll` (**read** 2026-11-11 from MSYS2 UCRT64's
+//! `libonecore.a`, mingw-w64 of clang 23.1.5's toolchain: `llvm-nm` lists the four there and none
+//! in `libkernel32.a`). A host that links the library statically names `-lonecore` itself.
+
+use std::ffi::c_void;
+
+/// `PAGE_NOACCESS`.
+pub(super) const PAGE_NOACCESS: u32 = 0x01;
+/// `PAGE_READONLY`.
+pub(super) const PAGE_READONLY: u32 = 0x02;
+/// `PAGE_READWRITE`.
+pub(super) const PAGE_READWRITE: u32 = 0x04;
+/// `PAGE_GUARD`.
+pub(super) const PAGE_GUARD: u32 = 0x100;
+
+/// `MEM_COMMIT`.
+pub(super) const MEM_COMMIT: u32 = 0x1000;
+/// `MEM_RESERVE`.
+pub(super) const MEM_RESERVE: u32 = 0x2000;
+/// `MEM_REPLACE_PLACEHOLDER`.
+pub(super) const MEM_REPLACE_PLACEHOLDER: u32 = 0x4000;
+/// `MEM_RELEASE`.
+pub(super) const MEM_RELEASE: u32 = 0x8000;
+/// `MEM_RESERVE_PLACEHOLDER`.
+pub(super) const MEM_RESERVE_PLACEHOLDER: u32 = 0x4_0000;
+/// `MEM_COALESCE_PLACEHOLDERS`, of `VirtualFree`.
+pub(super) const MEM_COALESCE_PLACEHOLDERS: u32 = 0x1;
+/// `MEM_PRESERVE_PLACEHOLDER`, of `VirtualFree` and `UnmapViewOfFile2`.
+pub(super) const MEM_PRESERVE_PLACEHOLDER: u32 = 0x2;
+
+/// `ERROR_NOT_ENOUGH_MEMORY`.
+pub(super) const ERROR_NOT_ENOUGH_MEMORY: i32 = 8;
+/// `ERROR_OUTOFMEMORY`.
+pub(super) const ERROR_OUTOFMEMORY: i32 = 14;
+/// `ERROR_COMMITMENT_LIMIT`: the system's commit limit (RAM and page files) is reached.
+pub(super) const ERROR_COMMITMENT_LIMIT: i32 = 1455;
+
+/// `SYSTEM_INFO` (`sysinfoapi.h`).
+#[repr(C)]
+pub(super) struct SystemInfo {
+    /// `wProcessorArchitecture` and `wReserved`.
+    pub(super) architecture: u32,
+    /// `dwPageSize`.
+    pub(super) page_size: u32,
+    /// `lpMinimumApplicationAddress`.
+    pub(super) minimum_address: *mut c_void,
+    /// `lpMaximumApplicationAddress`.
+    pub(super) maximum_address: *mut c_void,
+    /// `dwActiveProcessorMask`.
+    pub(super) active_processor_mask: usize,
+    /// `dwNumberOfProcessors`.
+    pub(super) processor_count: u32,
+    /// `dwProcessorType`.
+    pub(super) processor_type: u32,
+    /// `dwAllocationGranularity`.
+    pub(super) allocation_granularity: u32,
+    /// `wProcessorLevel`.
+    pub(super) processor_level: u16,
+    /// `wProcessorRevision`.
+    pub(super) processor_revision: u16,
+}
+
+/// `MEMORY_BASIC_INFORMATION` (`winnt.h`), as a 64-bit process reads it.
+#[repr(C)]
+pub(super) struct MemoryInfo {
+    /// `BaseAddress`.
+    pub(super) base: *mut c_void,
+    /// `AllocationBase`.
+    pub(super) allocation_base: *mut c_void,
+    /// `AllocationProtect`.
+    pub(super) allocation_protection: u32,
+    /// `PartitionId`.
+    pub(super) partition_id: u16,
+    /// `RegionSize`.
+    pub(super) region_size: usize,
+    /// `State`.
+    pub(super) state: u32,
+    /// `Protect`.
+    pub(super) protection: u32,
+    /// `Type`.
+    pub(super) kind: u32,
+}
+
+/// `MEMORYSTATUSEX` (`sysinfoapi.h`).
+#[repr(C)]
+pub(super) struct MemoryStatus {
+    /// `dwLength`: the structure's size, set by the caller.
+    pub(super) length: u32,
+    /// `dwMemoryLoad`.
+    pub(super) load: u32,
+    /// `ullTotalPhys`.
+    pub(super) total_physical: u64,
+    /// `ullAvailPhys`.
+    pub(super) available_physical: u64,
+    /// `ullTotalPageFile`.
+    pub(super) total_page_file: u64,
+    /// `ullAvailPageFile`.
+    pub(super) available_page_file: u64,
+    /// `ullTotalVirtual`.
+    pub(super) total_virtual: u64,
+    /// `ullAvailVirtual`.
+    pub(super) available_virtual: u64,
+    /// `ullAvailExtendedVirtual`.
+    pub(super) available_extended_virtual: u64,
+}
+
+/// `FILETIME` (`minwinbase.h`): 100 ns intervals since 1601-01-01 UTC, in two halves.
+#[repr(C)]
+pub(super) struct FileTime {
+    /// `dwLowDateTime`.
+    pub(super) low: u32,
+    /// `dwHighDateTime`.
+    pub(super) high: u32,
+}
+
+const _: () = {
+    assert!(size_of::<SystemInfo>() == 24 + 3 * size_of::<usize>());
+    assert!(size_of::<MemoryInfo>() == 48);
+    assert!(size_of::<MemoryStatus>() == 64);
+    assert!(size_of::<FileTime>() == 8);
+};
+
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    /// `void GetSystemInfo(LPSYSTEM_INFO)`.
+    pub(super) fn GetSystemInfo(info: *mut SystemInfo);
+    /// `HANDLE GetCurrentProcess(void)`: the pseudo handle of the process.
+    pub(super) fn GetCurrentProcess() -> *mut c_void;
+    /// `BOOL GlobalMemoryStatusEx(LPMEMORYSTATUSEX)`.
+    pub(super) fn GlobalMemoryStatusEx(status: *mut MemoryStatus) -> i32;
+    /// `void GetSystemTimePreciseAsFileTime(LPFILETIME)`.
+    pub(super) fn GetSystemTimePreciseAsFileTime(time: *mut FileTime);
+    /// `BOOL VirtualFree(LPVOID, SIZE_T, DWORD)`.
+    pub(super) fn VirtualFree(address: *mut c_void, size: usize, kind: u32) -> i32;
+    /// `BOOL VirtualProtect(LPVOID, SIZE_T, DWORD, PDWORD)`.
+    pub(super) fn VirtualProtect(
+        address: *mut c_void,
+        size: usize,
+        protection: u32,
+        old: *mut u32,
+    ) -> i32;
+    /// `SIZE_T VirtualQuery(LPCVOID, PMEMORY_BASIC_INFORMATION, SIZE_T)`.
+    pub(super) fn VirtualQuery(address: *const c_void, info: *mut MemoryInfo, size: usize)
+    -> usize;
+    /// `HANDLE CreateFileMappingW(HANDLE, LPSECURITY_ATTRIBUTES, DWORD, DWORD, DWORD, LPCWSTR)`.
+    pub(super) fn CreateFileMappingW(
+        file: *mut c_void,
+        attributes: *const c_void,
+        protection: u32,
+        size_high: u32,
+        size_low: u32,
+        name: *const u16,
+    ) -> *mut c_void;
+}
+
+#[link(name = "onecore")]
+unsafe extern "system" {
+    /// `void QueryInterruptTimePrecise(PULONGLONG)`: the interrupt time, in 100 ns units.
+    pub(super) fn QueryInterruptTimePrecise(time: *mut u64);
+    /// `PVOID VirtualAlloc2(HANDLE, PVOID, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER *, ULONG)`.
+    pub(super) fn VirtualAlloc2(
+        process: *mut c_void,
+        address: *mut c_void,
+        size: usize,
+        kind: u32,
+        protection: u32,
+        parameters: *mut c_void,
+        parameter_count: u32,
+    ) -> *mut c_void;
+    /// `PVOID MapViewOfFile3(HANDLE, HANDLE, PVOID, ULONG64, SIZE_T, ULONG, ULONG,
+    /// MEM_EXTENDED_PARAMETER *, ULONG)`.
+    pub(super) fn MapViewOfFile3(
+        section: *mut c_void,
+        process: *mut c_void,
+        address: *mut c_void,
+        offset: u64,
+        size: usize,
+        kind: u32,
+        protection: u32,
+        parameters: *mut c_void,
+        parameter_count: u32,
+    ) -> *mut c_void;
+    /// `BOOL UnmapViewOfFile2(HANDLE, PVOID, ULONG)`.
+    pub(super) fn UnmapViewOfFile2(process: *mut c_void, address: *mut c_void, flags: u32) -> i32;
+}
diff --git a/crates/reims-vgpu-vulkan/src/os/windows/backing.rs b/crates/reims-vgpu-vulkan/src/os/windows/backing.rs
new file mode 100644
index 000000000..7fb700004
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/os/windows/backing.rs
@@ -0,0 +1,684 @@
+//! The process's backing table on Windows: which section, from which offset, each byte of the
+//! memory the library may make a view of shows, so that a view is made by mapping sections and
+//! never by remapping addresses, which Windows has no call for (Mach's `mach_vm_remap`). It is
+//! Linux's table (`os/linux/files.rs`) over section handles, and it is also the record of the
+//! views the library mapped, which Windows needs kept exactly: the kernel unmaps a view only
+//! whole ([`super::vm`]).
+//!
+//! Two kinds of entry:
+//! - **Registrations** of memory the library does not map itself, or maps and lets only its
+//!   holder free: the guest's RAM, views of the sections the host names in its memory map (the
+//!   `guest_memory` lease of the memory map's device), and the memory of IOSurface's stand-in. One
+//!   registered again over the same handle and offset is counted, and goes with the last. A byte
+//!   resolves through the first registration that holds it.
+//! - **Runs** the library mapped: every range [`super::vm::WindowsVm`] allocated and every view it
+//!   made. A run shows `end - first` bytes of its section from its offset, with the protection
+//!   last set on it, and names the kernel's view it lies in ([`Run::view`]): a view is one or more
+//!   runs that follow on in its section, cut apart only where their protections differ (a
+//!   protect of part of a view changes no mapping). Runs never overlap.
+//!
+//! A byte in a run is found there first; a registration is looked at only for bytes no run
+//! holds. Because a view of a view resolves to the section, never to the first view's address,
+//! the second view keeps showing the pages after the first goes, as Mach's aliases do.
+//!
+//! Windows counts no mappings against a limit of the process's, so the table counts none, and no
+//! view is mapped another way than from its section (Linux's dma-bufs).
+//!
+//! The table's lock is held across the kernel's calls that change the views ([`table`], which
+//! [`super::vm`] takes for each call of its own), so the table and the kernel's views never
+//! differ for another thread; nothing else of the library is called under it.
+
+use std::collections::BTreeMap;
+use std::os::windows::io::OwnedHandle;
+use std::sync::Arc;
+
+use crate::core::sync::{Mutex, MutexGuard};
+
+use crate::os::GuestRamFile;
+
+/// Read access, as `VmProt` and the table's protections have it.
+pub(super) const READ: i32 = 1;
+/// Write access, as `VmProt` and the table's protections have it.
+pub(super) const WRITE: i32 = 2;
+/// The protection of a registration's bytes, and of a fresh range: read and write.
+pub(super) const READ_WRITE: i32 = READ | WRITE;
+
+/// The section behind a range: an open handle of it, and the offset in it of the range's first
+/// byte.
+#[derive(Clone, Debug)]
+pub(crate) struct Backing {
+    /// The section, held while any entry or view names it.
+    pub(crate) file: Arc<OwnedHandle>,
+    /// The section offset of the range's first byte.
+    pub(crate) offset: u64,
+}
+
+/// A run of the library's own mapping: its end, its section, the protection set on it (`VmProt`'s
+/// bits) and the kernel's view it lies in.
+#[derive(Clone, Debug)]
+pub(super) struct Run {
+    /// The byte past its last.
+    pub(super) end: u64,
+    /// The section it shows, from the offset of its first byte.
+    pub(super) backing: Backing,
+    /// The protection set on it.
+    pub(super) prot: i32,
+    /// The kernel's view it lies in: the view's first byte and the byte past its last. The runs
+    /// of one view follow on in the address space and in the section, and cover it.
+    pub(super) view: (u64, u64),
+}
+
+/// A registration: `first..end` shows `backing`, read and write, `count` times registered.
+#[derive(Debug)]
+struct Registered {
+    first: u64,
+    end: u64,
+    backing: Backing,
+    count: usize,
+}
+
+/// One piece of a range as the table resolves it: `length` bytes, `at` bytes into the range,
+/// showing `backing`, with protection `prot`.
+#[derive(Clone, Debug)]
+pub(crate) struct Piece {
+    pub(crate) at: u64,
+    pub(crate) length: u64,
+    pub(crate) backing: Backing,
+    pub(crate) prot: i32,
+}
+
+/// The table (module docs).
+#[derive(Debug, Default)]
+pub(super) struct Table {
+    registered: Vec<Registered>,
+    runs: BTreeMap<u64, Run>,
+}
+
+/// The process's table.
+static TABLE: Mutex<Table> = Mutex::new(Table {
+    registered: Vec::new(),
+    runs: BTreeMap::new(),
+});
+
+/// The process's table, locked: for the calls that change the kernel's views with it
+/// ([`super::vm`]).
+pub(super) fn table() -> MutexGuard<'static, Table> {
+    TABLE.lock()
+}
+
+impl Table {
+    /// The run holding byte `at`: its first byte and itself.
+    pub(super) fn run_at(&self, at: u64) -> Option<(u64, &Run)> {
+        (self.runs.range(..=at).next_back())
+            .filter(|(_, run)| at < run.end)
+            .map(|(&first, run)| (first, run))
+    }
+
+    /// The first run starting at or after `at`, before `end`: its first byte.
+    fn next_run(&self, at: u64, end: u64) -> Option<u64> {
+        self.runs.range(at..end).next().map(|(&first, _)| first)
+    }
+
+    /// The registration holding byte `at`.
+    fn registered_at(&self, at: u64) -> Option<&Registered> {
+        self.registered.iter().find(|r| r.first <= at && at < r.end)
+    }
+
+    /// The section behind byte `at`: the run or registration holding it, the section offset of
+    /// `at`, its protection, and the end of the bytes from `at` that show the same section on,
+    /// with the same protection, up to `end` (a registration's stop where a run starts); `None`
+    /// where neither holds it.
+    fn file_at(&self, at: u64, end: u64) -> Option<(&Arc<OwnedHandle>, u64, i32, u64)> {
+        if let Some((first, run)) = self.run_at(at) {
+            let offset = run.backing.offset + (at - first);
+            return Some((&run.backing.file, offset, run.prot, run.end.min(end)));
+        }
+        let registered = self.registered_at(at)?;
+        let to = (registered.end.min(end)).min(self.next_run(at, end).unwrap_or(end));
+        let offset = registered.backing.offset + (at - registered.first);
+        Some((&registered.backing.file, offset, READ_WRITE, to))
+    }
+
+    /// Cuts the run holding `at` in two there, where `at` lies past its first byte: two runs of
+    /// the same view, which no call of the kernel's follows.
+    pub(super) fn cut(&mut self, at: u64) {
+        let Some(first) = self.run_at(at).map(|(first, _)| first).filter(|&f| f < at) else {
+            return;
+        };
+        let Some(run) = self.runs.remove(&first) else {
+            return;
+        };
+        let tail = Run {
+            end: run.end,
+            backing: Backing {
+                file: Arc::clone(&run.backing.file),
+                offset: run.backing.offset + (at - first),
+            },
+            prot: run.prot,
+            view: run.view,
+        };
+        self.runs.insert(first, Run { end: at, ..run });
+        self.runs.insert(at, tail);
+    }
+
+    /// Whether every byte of `first..end` lies in a run.
+    pub(super) fn covered(&self, first: u64, end: u64) -> bool {
+        let mut at = first;
+        while at < end {
+            match self.run_at(at) {
+                Some((_, run)) => at = run.end,
+                None => return false,
+            }
+        }
+        true
+    }
+
+    /// The first stretch of `first..end` whose every byte lies in a run, of at most `most` runs:
+    /// its first byte and the byte past its last, a run that straddles either end counted whole;
+    /// `None` where no run meets the range.
+    pub(super) fn covered_stretch(&self, first: u64, end: u64, most: usize) -> Option<(u64, u64)> {
+        let start = match self.run_at(first) {
+            Some(_) => first,
+            None => self.next_run(first, end)?,
+        };
+        let mut at = start;
+        let mut runs = 0;
+        while at < end && runs < most {
+            match self.run_at(at) {
+                Some((_, run)) => at = run.end.min(end),
+                None => break,
+            }
+            runs += 1;
+        }
+        Some((start, at))
+    }
+
+    /// The kernel's views that meet `first..end`, each once, in order: its first byte and the
+    /// byte past its last.
+    pub(super) fn views_meeting(&self, first: u64, end: u64) -> Vec<(u64, u64)> {
+        let from = self.run_at(first).map_or(first, |(at, _)| at);
+        let mut views: Vec<(u64, u64)> = Vec::new();
+        for run in self.runs.range(from..end).map(|(_, run)| run) {
+            if views.last() != Some(&run.view) {
+                views.push(run.view);
+            }
+        }
+        views
+    }
+
+    /// The runs that lie in `first..end`, each with its first byte, in order: those the range
+    /// cuts are cut first ([`Table::cut`]).
+    pub(super) fn runs_in(&mut self, first: u64, end: u64) -> Vec<(u64, Run)> {
+        self.cut(first);
+        self.cut(end);
+        (self.runs.range(first..end))
+            .map(|(&at, run)| (at, run.clone()))
+            .collect()
+    }
+
+    /// Drops the runs that lie in `first..end`, which the range cuts none of.
+    pub(super) fn remove(&mut self, first: u64, end: u64) {
+        while let Some(at) = self.next_run(first, end) {
+            self.runs.remove(&at);
+        }
+    }
+
+    /// Adds `run` from `first`, over bytes no run holds.
+    pub(super) fn insert(&mut self, first: u64, run: Run) {
+        if first < run.end {
+            self.runs.insert(first, run);
+        }
+    }
+
+    /// Sets the protection of the runs that lie in `first..end`, which the range cuts none of.
+    pub(super) fn set_prot(&mut self, first: u64, end: u64, prot: i32) {
+        for (_, run) in self.runs.range_mut(first..end) {
+            run.prot = prot;
+        }
+    }
+
+    /// Appends to `into` the pieces of `length` bytes from `first` ([`pieces`]), the first `at`
+    /// bytes into the range `into` gathers, joined to the last piece there where it follows on in
+    /// its section with its protection; false where a byte has no section behind it, the pieces
+    /// of the bytes before it appended.
+    pub(super) fn pieces_into(
+        &self,
+        first: u64,
+        length: u64,
+        at: u64,
+        into: &mut Vec<Piece>,
+    ) -> bool {
+        let Some(end) = first.checked_add(length) else {
+            return false;
+        };
+        let mut from = first;
+        while from < end {
+            let Some((file, offset, prot, to)) = self.file_at(from, end) else {
+                return false;
+            };
+            match into.last_mut() {
+                Some(last)
+                    if Arc::ptr_eq(&last.backing.file, file)
+                        && last.backing.offset + last.length == offset
+                        && last.at + last.length == at + (from - first)
+                        && last.prot == prot =>
+                {
+                    last.length += to - from;
+                }
+                _ => into.push(Piece {
+                    at: at + (from - first),
+                    length: to - from,
+                    backing: Backing {
+                        file: Arc::clone(file),
+                        offset,
+                    },
+                    prot,
+                }),
+            }
+            from = to;
+        }
+        true
+    }
+
+    /// Whether every byte of `first..end` has `bit` in its protection: `None` where a byte lies
+    /// in neither a run nor a registration.
+    fn all_have(&self, first: u64, end: u64, bit: i32) -> Option<bool> {
+        let mut all = true;
+        let mut at = first;
+        while at < end {
+            let (_, _, prot, to) = self.file_at(at, end)?;
+            all &= prot & bit != 0;
+            at = to;
+        }
+        Some(all)
+    }
+
+    /// Whether a byte of `first..end` lies in a registration.
+    pub(super) fn meets_registration(&self, first: u64, end: u64) -> bool {
+        self.registered
+            .iter()
+            .any(|r| r.first < end && first < r.end)
+    }
+}
+
+/// The runs the table holds in `first..end`, each a view's or what a protect cut of one (tests).
+#[cfg(test)]
+pub(crate) fn runs_between(first: u64, end: u64) -> usize {
+    TABLE.lock().runs.range(first..end).count()
+}
+
+/// The kernel's views the table's runs in `first..end` lie in (tests).
+#[cfg(test)]
+pub(crate) fn views_between(first: u64, end: u64) -> usize {
+    TABLE.lock().views_meeting(first, end).len()
+}
+
+/// The pieces of `length` bytes from `first`, in order, each bytes of one section that follow on
+/// in it with one protection, through the runs and registrations over them; `None` where a byte
+/// has no section behind it.
+pub(crate) fn pieces(first: u64, length: u64) -> Option<Vec<Piece>> {
+    let mut pieces: Vec<Piece> = Vec::new();
+    TABLE
+        .lock()
+        .pieces_into(first, length, 0, &mut pieces)
+        .then_some(pieces)
+}
+
+/// Whether the table knows every byte of `length` bytes from `first`: `Some(readable)` where
+/// each lies in a run or a registration, readable where each has read access; `None` where one
+/// lies in neither.
+pub(crate) fn readable(first: u64, length: u64) -> Option<bool> {
+    let end = first.checked_add(length)?;
+    TABLE.lock().all_have(first, end, READ)
+}
+
+/// As [`readable`], for write access.
+pub(crate) fn writable(first: u64, length: u64) -> Option<bool> {
+    let end = first.checked_add(length)?;
+    TABLE.lock().all_have(first, end, WRITE)
+}
+
+/// A registration of `length` bytes from `first` as showing `backing` (module docs), until it
+/// drops.
+#[derive(Debug)]
+pub(crate) struct Registration {
+    first: u64,
+    end: u64,
+    backing: Backing,
+}
+
+impl Registration {
+    /// Registers `length` bytes from `first` as showing `backing`: counted again where the same
+    /// bytes are registered over the same section and offset.
+    pub(crate) fn new(first: u64, length: u64, backing: Backing) -> Registration {
+        let end = first.saturating_add(length);
+        let mut table = TABLE.lock();
+        match table
+            .registered
+            .iter_mut()
+            .find(|r| r.is(first, end, &backing))
+        {
+            Some(r) => r.count += 1,
+            None => table.registered.push(Registered {
+                first,
+                end,
+                backing: backing.clone(),
+                count: 1,
+            }),
+        }
+        Registration {
+            first,
+            end,
+            backing,
+        }
+    }
+}
+
+impl Registered {
+    /// Whether this registers `first..end` over `backing`.
+    fn is(&self, first: u64, end: u64, backing: &Backing) -> bool {
+        (self.first, self.end, self.backing.offset) == (first, end, backing.offset)
+            && Arc::ptr_eq(&self.backing.file, &backing.file)
+    }
+}
+
+impl Drop for Registration {
+    /// Counts the registration down, and drops it at the last.
+    fn drop(&mut self) {
+        let mut table = TABLE.lock();
+        if let Some(at) =
+            (table.registered.iter()).position(|r| r.is(self.first, self.end, &self.backing))
+        {
+            let r = &mut table.registered[at];
+            r.count -= 1;
+            if r.count == 0 {
+                table.registered.remove(at);
+            }
+        }
+    }
+}
+
+/// The guest's RAM registered while a device made over it lives: the `guest_memory` lease its
+/// device holds, made of the host's memory map, and dropped after core's teardown. Views of the
+/// guest's pages are made of these sections.
+#[derive(Debug)]
+pub struct GuestMemoryLease {
+    _registrations: Vec<Registration>,
+}
+
+/// Registers each range of the guest's RAM the host names a section behind: counted where the
+/// same range was registered already over the same handle (module docs). The host maps the
+/// ranges itself, each a view of its section (`MapViewOfFile`) from the offset it names, and the
+/// handle it gives maps views for reading and writing (`SECTION_MAP_READ | SECTION_MAP_WRITE`).
+///
+/// Nothing is handed to a device as RAM to copy by its runs, which Linux's lease also gives
+/// (`os/linux/host_ram.rs`): the devices here import a view's pages by their pointer.
+pub fn lease_guest_memory(ranges: impl IntoIterator<Item = GuestRamFile>) -> GuestMemoryLease {
+    let registrations = ranges
+        .into_iter()
+        .map(|r| {
+            let backing = Backing {
+                file: r.handle,
+                offset: r.offset,
+            };
+            Registration::new(r.host, r.length, backing)
+        })
+        .collect();
+    GuestMemoryLease {
+        _registrations: registrations,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::vm;
+    use super::*;
+
+    /// A section for the tests' backings.
+    fn file() -> Arc<OwnedHandle> {
+        vm::section(0x10_0000).unwrap()
+    }
+
+    /// The pieces' (offset in the range, length, section offset).
+    fn shape(pieces: &[Piece]) -> Vec<(u64, u64, u64)> {
+        pieces
+            .iter()
+            .map(|p| (p.at, p.length, p.backing.offset))
+            .collect()
+    }
+
+    /// Records `length` bytes from `first` as a run of `backing`, a view of its own, as the VM
+    /// records one it mapped; nothing is mapped.
+    fn record(first: u64, length: u64, backing: Backing, prot: i32) {
+        let end = first + length;
+        let mut table = table();
+        let _ = table.runs_in(first, end);
+        table.remove(first, end);
+        let view = (first, end);
+        table.insert(
+            first,
+            Run {
+                end,
+                backing,
+                prot,
+                view,
+            },
+        );
+    }
+
+    /// Forgets the runs of `length` bytes from `first`.
+    fn forget(first: u64, length: u64) {
+        let mut table = table();
+        let _ = table.runs_in(first, first + length);
+        table.remove(first, first + length);
+    }
+
+    // The table is the process's: each test uses address ranges of its own, far apart, in the
+    // half of the address space the kernel keeps.
+
+    /// A range resolves through the runs over it, cut where they end, then the registrations;
+    /// a byte of neither leaves it unresolved
+    #[test]
+    fn a_range_resolves_through_runs_then_registrations() {
+        let f = file();
+        let base = 0xffff_a000_0000_0000;
+        let backing = |offset| Backing {
+            file: Arc::clone(&f),
+            offset,
+        };
+        let held = Registration::new(base, 0x10_000, backing(0x80_000));
+        record(base + 0x20_000, 0x2000, backing(0x5000), READ);
+        assert_eq!(
+            shape(&pieces(base + 0x1000, 0x2000).unwrap()),
+            [(0, 0x2000, 0x81_000)]
+        );
+        assert_eq!(
+            shape(&pieces(base + 0x20_000, 0x2000).unwrap()),
+            [(0, 0x2000, 0x5000)]
+        );
+        assert!(pieces(base + 0x10_000, 0x1000).is_none());
+        assert!(pieces(base + 0x1f_000, 0x2000).is_none());
+        assert_eq!(readable(base + 0x20_000, 0x2000), Some(true));
+        assert_eq!(readable(base, 0x10_000), Some(true));
+        {
+            let mut table = table();
+            let _ = table.runs_in(base + 0x21_000, base + 0x22_000);
+            table.set_prot(base + 0x21_000, base + 0x22_000, 0);
+        }
+        assert_eq!(readable(base + 0x20_000, 0x1000), Some(true));
+        assert_eq!(readable(base + 0x20_000, 0x2000), Some(false));
+        assert_eq!(
+            shape(&pieces(base + 0x20_000, 0x2000).unwrap()),
+            [(0, 0x1000, 0x5000), (0x1000, 0x1000, 0x6000)]
+        );
+        assert_eq!(runs_between(base + 0x20_000, base + 0x22_000), 2);
+        assert_eq!(
+            views_between(base + 0x20_000, base + 0x22_000),
+            1,
+            "a protect cuts no view"
+        );
+        assert_eq!(readable(base + 0x30_000, 1), None);
+        drop(held);
+        assert!(pieces(base, 0x1000).is_none());
+        forget(base + 0x20_000, 0x2000);
+    }
+
+    /// A run replaces what of another it covers, and an unmap drops what it covers, keeping
+    /// each run's other bytes at their section offsets
+    #[test]
+    fn runs_never_overlap() {
+        let f = file();
+        let base = 0xffff_a100_0000_0000;
+        let backing = |offset| Backing {
+            file: Arc::clone(&f),
+            offset,
+        };
+        record(base, 0x4000, backing(0x10_000), READ_WRITE);
+        record(base + 0x1000, 0x1000, backing(0x90_000), READ);
+        assert_eq!(
+            shape(&pieces(base, 0x4000).unwrap()),
+            [
+                (0, 0x1000, 0x10_000),
+                (0x1000, 0x1000, 0x90_000),
+                (0x2000, 0x2000, 0x12_000)
+            ]
+        );
+        forget(base + 0x2000, 0x1000);
+        assert!(pieces(base, 0x4000).is_none());
+        assert_eq!(
+            shape(&pieces(base + 0x3000, 0x1000).unwrap()),
+            [(0, 0x1000, 0x13_000)]
+        );
+        forget(base, 0x4000);
+        assert!(pieces(base, 1).is_none());
+    }
+
+    /// A lease registers each range of the guest's RAM at its section offset, until it drops
+    #[test]
+    fn a_lease_registers_the_guests_ram_while_held() {
+        let f = file();
+        let base = 0xffff_a200_0000_0000;
+        let ram = |host, length, offset| GuestRamFile {
+            host,
+            guest: offset,
+            length,
+            handle: Arc::clone(&f),
+            offset,
+        };
+        let lease =
+            lease_guest_memory([ram(base, 0x4000, 0), ram(base + 0x10_000, 0x2000, 0x4000)]);
+        assert_eq!(
+            shape(&pieces(base + 0x1000, 0x1000).unwrap()),
+            [(0, 0x1000, 0x1000)]
+        );
+        assert_eq!(
+            shape(&pieces(base + 0x11_000, 0x1000).unwrap()),
+            [(0, 0x1000, 0x5000)]
+        );
+        assert!(pieces(base + 0x4000, 0x1000).is_none());
+        assert_eq!(writable(base, 0x4000), Some(true));
+        assert!(table().meets_registration(base + 0x3000, base + 0x5000));
+        drop(lease);
+        assert!(pieces(base, 0x1000).is_none());
+        assert!(pieces(base + 0x10_000, 0x1000).is_none());
+    }
+
+    /// Runs that follow on in one section with one protection resolve as one piece, which a view
+    /// of them maps as one; a protection or a section apart cuts it
+    #[test]
+    fn runs_that_follow_on_resolve_as_one_piece() {
+        let (f, g) = (file(), file());
+        let base = 0xffff_a300_0000_0000;
+        let backing = |file: &Arc<OwnedHandle>, offset| Backing {
+            file: Arc::clone(file),
+            offset,
+        };
+        for i in 0..4 {
+            record(
+                base + i * 0x1000,
+                0x1000,
+                backing(&f, 0x8000 + i * 0x1000),
+                READ_WRITE,
+            );
+        }
+        assert_eq!(
+            shape(&pieces(base + 0x800, 0x3000).unwrap()),
+            [(0, 0x3000, 0x8800)]
+        );
+        record(base + 0x2000, 0x1000, backing(&f, 0xa000), READ);
+        record(base + 0x3000, 0x1000, backing(&g, 0xb000), READ_WRITE);
+        assert_eq!(
+            shape(&pieces(base, 0x4000).unwrap()),
+            [
+                (0, 0x2000, 0x8000),
+                (0x2000, 0x1000, 0xa000),
+                (0x3000, 0x1000, 0xb000)
+            ]
+        );
+        assert_eq!(
+            (readable(base, 0x4000), writable(base, 0x4000)),
+            (Some(true), Some(false))
+        );
+        assert_eq!(writable(base, 0x5000), None);
+        forget(base, 0x4000);
+    }
+
+    /// The same bytes registered again over the same section and offset are counted: they stay
+    /// until the last registration drops
+    #[test]
+    fn registrations_are_counted() {
+        let f = file();
+        let base = 0xffff_a400_0000_0000;
+        let backing = || Backing {
+            file: Arc::clone(&f),
+            offset: 0,
+        };
+        let first = Registration::new(base, 0x1000, backing());
+        let second = Registration::new(base, 0x1000, backing());
+        drop(first);
+        assert!(pieces(base, 0x1000).is_some());
+        drop(second);
+        assert!(pieces(base, 0x1000).is_none());
+    }
+
+    /// A covered stretch is the first run of bytes of a range that runs hold, as far as a count
+    /// of them; the views that meet a range are each counted once
+    #[test]
+    fn stretches_and_views_follow_the_runs() {
+        let f = file();
+        let base = 0xffff_a500_0000_0000;
+        let backing = |offset| Backing {
+            file: Arc::clone(&f),
+            offset,
+        };
+        record(base + 0x1000, 0x2000, backing(0), READ_WRITE);
+        record(base + 0x3000, 0x1000, backing(0x9000), READ_WRITE);
+        record(base + 0x5000, 0x1000, backing(0x5000), READ_WRITE);
+        let table = table();
+        assert_eq!(
+            table.covered_stretch(base, base + 0x8000, 8),
+            Some((base + 0x1000, base + 0x4000))
+        );
+        assert_eq!(
+            table.covered_stretch(base + 0x1800, base + 0x8000, 1),
+            Some((base + 0x1800, base + 0x3000))
+        );
+        assert_eq!(
+            table.covered_stretch(base + 0x4000, base + 0x8000, 8),
+            Some((base + 0x5000, base + 0x6000))
+        );
+        assert_eq!(table.covered_stretch(base + 0x6000, base + 0x8000, 8), None);
+        assert!(table.covered(base + 0x1000, base + 0x4000));
+        assert!(!table.covered(base + 0x1000, base + 0x5000));
+        assert_eq!(
+            table.views_meeting(base + 0x2000, base + 0x6000),
+            [
+                (base + 0x1000, base + 0x3000),
+                (base + 0x3000, base + 0x4000),
+                (base + 0x5000, base + 0x6000)
+            ]
+        );
+        drop(table);
+        forget(base, 0x8000);
+    }
+}
