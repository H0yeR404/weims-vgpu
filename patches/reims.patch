+    }
+
+    /// A surface made from plane properties is its planes' whole pages, 1 byte per element and
+    /// rows of its width rounded up to 128 bytes
+    #[test]
+    fn a_backing_surface_is_its_planes() {
+        let spec = BackingSurfaceSpec {
+            pixel_format: BGRA,
+            planes: vec![
+                BackingPlaneSpec {
+                    width: 16,
+                    height: 16,
+                    bytes_per_element: 1,
+                    bytes_per_row: 16,
+                    base: 0,
+                    offset: 0,
