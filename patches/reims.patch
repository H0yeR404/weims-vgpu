--- /dev/null
+++ b/crates/reims-vgpu-c/src/memory/windows_tests.rs
@@ -0,0 +1,252 @@
+use std::os::windows::io::{AsRawHandle as _, FromRawHandle as _, OwnedHandle};
+
+use super::*;
+use std::ffi::c_void;
+
+/// Section descriptors feed the real Windows remapper, including offsets smaller than 64 KiB
+/// and a surface assembled from scattered guest pages. The views outlive the source mapping.
+#[test]
+fn section_descriptors_map_scattered_guest_pages() {
+    use reims_vgpu_vulkan::core::platform::os::vm::{HostAddr, HostVm};
+    use reims_vgpu_vulkan::os::{GuestRamFile, OsVm, lease_guest_memory};
+
+    let host = section(0x2_0000);
+    // SAFETY: a new writable view of the section, unmapped after its aliases have been made.
+    let base = unsafe { MapViewOfFile(host.as_raw_handle(), 2, 0, 0, 0x2_0000) };
+    assert!(!base.is_null());
+    // SAFETY: the section holds this page and the next 15 pages.
+    let start = unsafe { base.cast::<u8>().add(0x1000) };
+    let range = RvgMemoryRange {
+        physical_address: 0x1_0000_0000,
+        physical_length: 0xf000,
+        host_address: start.cast(),
+    };
+    let map = RvgMemoryMap {
+        ranges: &range,
+        range_count: 1,
+    };
+    let entry = descriptor(&host, 0x1000, 0x2_0000);
+    // SAFETY: the source is a writable view at precisely the section offset named above.
+    let memory = unsafe { memory_map(&map, std::ptr::null(), &entry) }
+        .unwrap()
+        .unwrap();
+    let backing = memory.files()[0].as_ref().unwrap();
+    let lease = lease_guest_memory([GuestRamFile {
+        host: start.addr() as u64,
+        guest: range.physical_address,
+        length: range.physical_length,
+        handle: std::sync::Arc::clone(&backing.handle),
+        offset: backing.offset,
+    }]);
+    let vm = OsVm::new();
+    let target = vm.allocate_anywhere(0x3000).unwrap();
+    let source = HostAddr::from_ptr(start);
+    vm.remap_runs_shared_overwrite(
+        target,
+        &[
+            (source.wrapping_add(0x5000), 0x1000),
+            (source.wrapping_add(0x2000), 0x2000),
+        ],
+    )
+    .unwrap();
+    let alias = std::ptr::with_exposed_provenance_mut::<u8>(target.addr());
+    // SAFETY: the two views above alias these pages; accesses are sequential.
+    unsafe {
+        start.add(0x5000).write(0xa5);
+        assert_eq!(alias.read(), 0xa5);
+        alias.add(0x1007).write(0x5a);
+        assert_eq!(start.add(0x2007).read(), 0x5a);
+        start.add(0x3003).write(0x6b);
+        assert_eq!(alias.add(0x2003).read(), 0x6b);
+    }
+    drop(host);
+    drop(memory);
+    drop(lease);
+    // SAFETY: the original view is no longer used. The independently mapped aliases remain.
+    unsafe {
+        assert_ne!(UnmapViewOfFile(base), 0);
+        assert_eq!(alias.read(), 0xa5);
+        assert_eq!(alias.add(0x2003).read(), 0x6b);
+    }
+    assert!(vm.deallocate(target, 0x3000).is_success());
+}
+
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn CreateFileMappingW(
+        file: *mut c_void,
+        attrs: *const c_void,
+        protection: u32,
+        high: u32,
+        low: u32,
+        name: *const u16,
+    ) -> *mut c_void;
+    fn MapViewOfFile(
+        section: *mut c_void,
+        access: u32,
+        high: u32,
+        low: u32,
+        len: usize,
+    ) -> *mut c_void;
+    fn UnmapViewOfFile(address: *const c_void) -> i32;
+    fn GetHandleInformation(handle: *mut c_void, flags: *mut u32) -> i32;
+}
+
+fn section(length: u32) -> OwnedHandle {
+    // SAFETY: a fresh pagefile-backed, writable section of the requested size.
+    let raw = unsafe {
+        CreateFileMappingW(
+            std::ptr::with_exposed_provenance_mut(usize::MAX),
+            std::ptr::null(),
+            4,
+            0,
+            length,
+            std::ptr::null(),
+        )
+    };
+    assert!(!raw.is_null());
+    // SAFETY: the new section has one owner.
+    unsafe { OwnedHandle::from_raw_handle(raw) }
+}
+
+fn descriptor(section: &OwnedHandle, offset: u64, length: u64) -> RvgMemoryRangeSection {
+    RvgMemoryRangeSection {
+        handle: u64::try_from(section.as_raw_handle().addr()).unwrap(),
+        offset,
+        length,
+        flags: 0,
+        reserved: 0,
+    }
+}
+
+/// Invalid handles, arithmetic, sizes, alignment and reserved fields all reach real refusal paths.
+#[test]
+fn memory_section_refusals() {
+    let range = RvgMemoryRange {
+        physical_address: 0,
+        physical_length: 0x4000,
+        host_address: std::ptr::null_mut(),
+    };
+    let map = RvgMemoryMap {
+        ranges: &range,
+        range_count: 1,
+    };
+    let host = section(0x1_0000);
+    let good = descriptor(&host, 0, 0x1_0000);
+    let refused = |entry: RvgMemoryRangeSection| {
+        // SAFETY: one live range and one live descriptor.
+        assert_eq!(
+            unsafe { memory_map(&map, std::ptr::null(), &entry) }.err(),
+            Some(RVG_ERR_INVALID_ARGUMENT)
+        );
+    };
+    refused(RvgMemoryRangeSection {
+        handle: u64::MAX,
+        ..good
+    });
+    refused(RvgMemoryRangeSection {
+        length: 0x2000,
+        ..good
+    });
+    refused(RvgMemoryRangeSection {
+        offset: u64::MAX - 1,
+        length: u64::MAX,
+        ..good
+    });
+    refused(RvgMemoryRangeSection { offset: 1, ..good });
+    refused(RvgMemoryRangeSection {
+        length: 0x4_0000,
+        ..good
+    });
+    refused(RvgMemoryRangeSection { flags: 1, ..good });
+    refused(RvgMemoryRangeSection {
+        reserved: 1,
+        ..good
+    });
+    let file = RvgMemoryRangeFile {
+        fd: -1,
+        flags: 0,
+        offset: 0,
+    };
+    // SAFETY: live matching entries; the combination is refused before reading them.
+    assert_eq!(
+        unsafe { memory_map(&map, &file, &good) }.err(),
+        Some(RVG_ERR_INVALID_ARGUMENT)
+    );
+    // SAFETY: no map; sections without one are refused.
+    assert_eq!(
+        unsafe { memory_map(std::ptr::null(), std::ptr::null(), &good) }.err(),
+        Some(RVG_ERR_INVALID_ARGUMENT)
+    );
+    // SAFETY: a live range without section backing is accepted.
+    assert!(
+        unsafe { memory_map(&map, std::ptr::null(), std::ptr::null()) }
+            .unwrap()
+            .unwrap()
+            .files()[0]
+            .is_none()
+    );
+}
+
+/// The noninheritable duplicate retains the same shared pages after the host closes its handle.
+#[test]
+fn memory_sections_are_duplicated_and_alias_the_host_pages() {
+    let host = section(0x2_0000);
+    let entry = descriptor(&host, 0x1_0000, 0x2_0000);
+    // SAFETY: a writable view of the host's section at an allocation-aligned offset.
+    let view = unsafe { MapViewOfFile(host.as_raw_handle(), 2, 0, 0x1_0000, 0x4000) };
+    assert!(!view.is_null());
+    let range = RvgMemoryRange {
+        physical_address: 0,
+        physical_length: 0x4000,
+        host_address: view,
+    };
+    let map = RvgMemoryMap {
+        ranges: &range,
+        range_count: 1,
+    };
+    // SAFETY: the range is really backed by this section and remains mapped until after the map drops.
+    let m = unsafe { memory_map(&map, std::ptr::null(), &entry) }
+        .unwrap()
+        .unwrap();
+    let backing = m.files()[0].as_ref().unwrap();
+    assert_eq!(backing.offset, 0x1_0000);
+    let duplicate = backing.handle.as_raw_handle();
+    assert_ne!(duplicate, host.as_raw_handle());
+    let mut flags = 0u32;
+    // SAFETY: a query of the duplicate that the map owns.
+    assert_ne!(
+        unsafe { GetHandleInformation(duplicate, &raw mut flags) },
+        0
+    );
+    assert_eq!(flags & 1, 0);
+    drop(host);
+    // SAFETY: the duplicate still names the same section after the original handle closes.
+    let second = unsafe { MapViewOfFile(duplicate, 2, 0, 0x1_0000, 0x4000) };
+    assert!(!second.is_null());
+    // SAFETY: both writable views hold this byte and really alias the same section.
+    unsafe {
+        view.cast::<u8>().write(0xa5);
+        assert_eq!(second.cast::<u8>().read(), 0xa5);
+        second.cast::<u8>().write(0x5a);
+        assert_eq!(view.cast::<u8>().read(), 0x5a);
+    }
+    let copy = m.clone();
+    drop(m);
+    // SAFETY: the last cloned map still owns the duplicate.
+    assert_ne!(
+        unsafe { GetHandleInformation(duplicate, &raw mut flags) },
+        0
+    );
+    drop(copy);
+    // SAFETY: querying a closed handle returns an error, without taking ownership.
+    assert_eq!(
+        unsafe { GetHandleInformation(duplicate, &raw mut flags) },
+        0
+    );
+    // SAFETY: release the two views created above.
+    unsafe {
+        assert_ne!(UnmapViewOfFile(second), 0);
+        assert_ne!(UnmapViewOfFile(view), 0);
+    }
+}
