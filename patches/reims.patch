+        write(a, PAGE, 0x77);
+        assert_eq!(read(a, PAGE), 0x77);
+        assert_eq!(views_and_runs(a, 4), (3, 3));
+        v.allocate_fixed_overwrite(a.wrapping_add(0x80), 0).unwrap();
+        assert_eq!(read(a, 0), 0x10, "no bytes: nothing");
