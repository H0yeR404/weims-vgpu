@@ -0,0 +1,512 @@
+//! What the runtime imports for host memory on Windows: the memory itself, and for a surface's
+//! read-only alias, a writable twin of it.
+//!
+//! The runtime imports host memory by its pointer (`VK_EXT_external_memory_host`), and refuses
+//! pages the process cannot write before it asks the driver: NVIDIA's Windows driver answers a
+//! read-only section view as out of device memory (the runtime's `host_memory/windows.rs`, which
+//! asks `VirtualQuery`). It then makes the buffer or heap over a copy of the pages whose GPU
+//! writes it drops, as Metal's GPU drops them (its `copied-host-pages`, a kind of
+//! `crate::answer::DIES`), so the GPU reads what Metal's reads and its writes reach nothing past
+//! the copy ([`ImportView::read_only`]); so does an object made with `MTLResourceOptions` bit
+//! 24, whatever its pages. So read-only memory is given as it is, for the runtime to copy: the
+//! guest's ranges core maps read-only, aliases of a read-only replace or heap, and a no-copy
+//! buffer or heap over pages mapped read-only. What Metal answers otherwise than a dropped write
+//! there (a pass's store into such memory, a texture's writes) is `crate::gpu::writes`'s.
+//!
+//! A surface's read-only alias is given a **twin** instead
+//! (`crate::gpu::backing::ImportSite::twins`), as on Linux (`os/linux/import.rs`): a second view
+//! of the same section pages, read and write, at an address of its own ([`import_view`]),
+//! imported in place, so a surface's buffers lie in one import of the pages, as a writer's GPU
+//! writes through another import reach its readers, where a copy would read them as they were at
+//! its commit. The GPU then reads what Metal's reads, but its writes reach those pages, where
+//! Metal drops them: every command that may write through an object over such an import dies
+//! where it is encoded, naming it (`crate::gpu::writes::kept_write`).
+//!
+//! The block of zeros a read-only alias maps past its ranges' pages is a section of zeros all
+//! such aliases share ([`allocate_zeros`]). Its twin is zeros of the twin's own instead, so the
+//! GPU's writes there stay in that twin and never reach the block, though they are kept for the
+//! alias's life, where Metal drops them, which the same deaths stop.
+//!
+//! A buffer made over a twin answers the address it was made over as its contents
+//! ([`shown_at`]): the runtime's contents are the twin's. The twin goes once the runtime frees the
+//! import (its keep-alive, [`ImportView::release`]).
+//!
+//! No import carries a dma-buf source or a gate over it, which Linux's carry: every device here
+//! takes the pages by their pointer or not at all, the views take no budget of mappings
+//! ([`super::vm`]), and the runtime finds read-only pages itself.
+
+use std::collections::BTreeMap;
+use std::os::windows::io::OwnedHandle;
+use std::ptr::NonNull;
+use std::sync::Arc;
+
+use crate::core::num::{ToU64, ToUsize};
+use crate::core::platform::os::vm::{HostAddr, HostVm as _, KernReturn};
+use crate::core::sync::Mutex;
+use metal2vulkan_runtime as rt;
+
+use super::backing::{self as files, READ_WRITE};
+use super::vm::{self, WindowsVm};
+
+/// Whether the runtime imports a surface's read-only alias through a writable twin of its
+/// sections: on Windows, as on Linux, so read-only memory the library makes has a section behind
+/// every byte (module docs).
+pub(crate) const TWINS_READ_ONLY: bool = true;
+
+/// Whether the runtime makes read-only memory other than a surface's, and memory made with
+/// `MTLResourceOptions` bit 24, over a copy of it whose GPU writes it drops, where Metal's GPU
+/// keeps them from the memory itself: on Windows, as on Linux, where the runtime's device
+/// answers no to `drops_gpu_writes_to_read_only_memory` (module docs).
+pub(crate) const COPIES_READ_ONLY: bool = true;
+
+/// Every live twin, by its first byte: its length and the first byte of the memory it twins.
+static TWINS: Mutex<BTreeMap<u64, (u64, u64)>> = Mutex::new(BTreeMap::new());
+
+/// The sections of zeros ([`allocate_zeros`]), held for the process.
+static ZERO_FILES: Mutex<Vec<Arc<OwnedHandle>>> = Mutex::new(Vec::new());
+
+/// A fresh range of `len` bytes of zeros that a view can be made of, as
+/// [`vm::allocate_aliasable`] makes, whose section is kept for the process: an import's twin of
+/// it is zeros of the twin's own, never the section (module docs).
+pub(crate) fn allocate_zeros(len: u64) -> Result<HostAddr, KernReturn> {
+    let at = vm::allocate_aliasable(len)?;
+    if let Some(piece) = files::pieces(at.addr().to_u64(), 1).and_then(|p| p.into_iter().next()) {
+        ZERO_FILES.lock().push(piece.backing.file);
+    }
+    Ok(at)
+}
+
+/// Whether each of `pieces` is of a section of zeros, the sections looked at once.
+pub(super) fn of_zeros(pieces: &[files::Piece]) -> Vec<bool> {
+    let zero_files = ZERO_FILES.lock();
+    let zeros = |file: &Arc<OwnedHandle>| zero_files.iter().any(|z| Arc::ptr_eq(z, file));
+    pieces.iter().map(|p| zeros(&p.backing.file)).collect()
+}
+
+/// The memory the runtime imports for `length` bytes at `at` (module docs).
+#[derive(Debug)]
+pub(crate) struct ImportView {
+    at: NonNull<u8>,
+    twin: Option<Twin>,
+    /// The table shows every page of the import mapped writable ([`ImportView::vouched`]).
+    vouched: bool,
+    /// The table shows a page of the memory mapped read-only ([`ImportView::read_only`]).
+    read_only: bool,
+}
+
+// SAFETY: `at` is an address only, which nothing here reads through: it is handed to the runtime;
+// the twin is unmapped once, by whichever thread drops the view.
+unsafe impl Send for ImportView {}
+
+// SAFETY: as for `Send`: a shared view only answers where it is.
+unsafe impl Sync for ImportView {}
+
+/// A writable twin's address range, unmapped when it drops.
+#[derive(Debug)]
+struct Twin {
+    first: u64,
+    length: u64,
+}
+
+impl Drop for Twin {
+    fn drop(&mut self) {
+        TWINS.lock().remove(&self.first);
+        // The twin's own range, which the runtime let go of (it freed the import and dropped its
+        // keep-alive, or the call that would import it was refused).
+        let at = HostAddr::from_addr(self.first.to_usize());
+        let _ = WindowsVm::new().deallocate(at, self.length);
+    }
+}
+
+impl ImportView {
+    /// The first byte the runtime imports.
+    pub(crate) fn at(&self) -> NonNull<u8> {
+        self.at
+    }
+
+    /// Whether the import is a writable twin of memory mapped read-only, the guest's pages or
+    /// zeros, whose GPU writes reach them where Metal drops them (module docs).
+    #[cfg(test)]
+    pub(crate) fn twinned(&self) -> bool {
+        self.twin.is_some()
+    }
+
+    /// Whether the table shows a page of the memory mapped read-only: the runtime is given its
+    /// twin, or the pages themselves, which it finds read-only and makes the object over a copy
+    /// of, whose GPU writes it drops (module docs).
+    pub(crate) fn read_only(&self) -> bool {
+        self.read_only
+    }
+
+    /// Whether the runtime may be told the import's pages are writable ([`host_memory_vouched`]):
+    /// the memory itself, not a twin, every page of which the table shows mapped with write
+    /// permission now, as the library's own ranges and views and the guest's RAM are. Where it
+    /// does not know a page, or a page is read-only, the runtime asks the system as before.
+    pub(crate) fn vouched(&self) -> bool {
+        self.vouched
+    }
+
+    /// The runtime's deallocator of the import, and what keeps the import's memory mapped beside
+    /// the bytes themselves. With a twin: `inner`, given `original`, the address the bytes were
+    /// given at, and the twin, which the runtime drops once it freed the import, so the twin is
+    /// unmapped after it. Without one, `inner` as it is, and nothing.
+    pub(crate) fn release(
+        self,
+        original: NonNull<u8>,
+        inner: Option<rt::Deallocator>,
+    ) -> (Option<rt::Deallocator>, Option<rt::KeepAlive>) {
+        let Some(twin) = self.twin else {
+            return (inner, None);
+        };
+        let original = SendPtr(original);
+        let inner = inner.map(|inner| -> rt::Deallocator {
+            Box::new(move |_, length| inner(original.get(), length))
+        });
+        (inner, Some(Box::new(twin)))
+    }
+}
+
+/// The runtime's host memory at `at`, the first byte of an import ([`ImportView::at`]): the bytes
+/// alone, which a device imports by their pointer (module docs).
+///
+/// # Safety
+///
+/// `rt::HostMemory::new`'s contract, for the memory at `at`.
+pub(crate) unsafe fn host_memory(at: NonNull<u8>) -> rt::HostMemory {
+    // SAFETY: the caller's.
+    unsafe { rt::HostMemory::new(at) }
+}
+
+/// [`host_memory`], its pages' write permission vouched for where `vouched`
+/// ([`ImportView::vouched`]): the runtime then asks the system nothing of the pages before it
+/// imports them, where it would ask about every region of them, one `VirtualQuery` each, a view
+/// of scattered pages a region a run.
+///
+/// # Safety
+///
+/// [`host_memory`]'s; and where `vouched`, every page of the import is mapped writable by this
+/// process now (the table's record, [`ImportView::vouched`]), and stays mapped so while it is
+/// imported, as `rt::HostMemory::assume_writable` asks: an unmap of the library's own waits for
+/// the import's free (`crate::remap`'s `UnmapHold`).
+pub(crate) unsafe fn host_memory_vouched(at: NonNull<u8>, vouched: bool) -> rt::HostMemory {
+    // SAFETY: the caller's.
+    let memory = unsafe { host_memory(at) };
+    match vouched {
+        // SAFETY: the caller's.
+        true => unsafe { memory.assume_writable() },
+        false => memory,
+    }
+}
+
+/// Why this thread's last dma-buf source made none: never, on Windows, where imports carry none.
+pub(crate) fn dma_buf_refusal() -> Option<String> {
+    None
+}
+
+/// An address moved into a deallocator, which may run on any thread.
+struct SendPtr(NonNull<u8>);
+
+// SAFETY: an address only, handed back to the deallocator it was given for.
+unsafe impl Send for SendPtr {}
+
+impl SendPtr {
+    /// The address.
+    fn get(self) -> NonNull<u8> {
+        self.0
+    }
+}
+
+/// The memory the runtime imports for `length` bytes at `at`: those bytes where every page of
+/// them is mapped writable or one has no section behind it (which the runtime then judges as it
+/// judges any import there), or where one is mapped read-only and `twin` is false (which the
+/// runtime copies, dropping the GPU's writes); and otherwise, a surface's read-only alias, a
+/// writable twin of their pages, at the same offset in its first page (module docs). Where the
+/// host maps no twin, the bytes themselves, read-only.
+pub(crate) fn import_view(at: NonNull<u8>, length: u64, twin: bool) -> ImportView {
+    let mut plain = ImportView {
+        at,
+        twin: None,
+        vouched: false,
+        read_only: false,
+    };
+    let start = at.as_ptr().addr().to_u64();
+    let page = vm::page_size();
+    let first = start & !(page - 1);
+    let Some(end) = start
+        .checked_add(length.max(1))
+        .and_then(|e| e.checked_next_multiple_of(page))
+    else {
+        return plain;
+    };
+    // Looked up without collecting the pieces, which only a twin needs.
+    let writable = files::writable(first, end - first);
+    if writable != Some(false) {
+        plain.vouched = writable == Some(true);
+        return plain;
+    }
+    plain.read_only = true;
+    if !twin {
+        return plain;
+    }
+    let Some(pieces) = files::pieces(first, end - first) else {
+        return plain;
+    };
+    let Some(twin) = self::twin(first, end - first, pieces) else {
+        return plain;
+    };
+    log::debug!(
+        "an import of {length:#x} bytes at {start:#x}: a writable twin at {:#x}",
+        twin.first
+    );
+    let Some(twin_at) = address(twin.first + (start - first)) else {
+        return plain;
+    };
+    ImportView {
+        at: twin_at,
+        twin: Some(twin),
+        ..plain
+    }
+}
+
+/// A writable twin of the `length` bytes from `first` that `pieces` show: a fresh range of
+/// zeros, over which each piece's section pages are mapped, shared, read and write, but zeros',
+/// which show the fresh range's own section there; `None` where the host gives no range or
+/// refuses a piece, nothing left mapped.
+fn twin(first: u64, length: u64, pieces: Vec<files::Piece>) -> Option<Twin> {
+    let zeros = of_zeros(&pieces);
+    let base = WindowsVm::new().allocate_anywhere(length).ok()?;
+    // Unmapped as it drops, where a piece is refused.
+    let twin = Twin {
+        first: base.addr().to_u64(),
+        length,
+    };
+    let own = files::pieces(twin.first, length)?
+        .into_iter()
+        .next()?
+        .backing;
+    let pieces: Vec<files::Piece> = (pieces.into_iter().zip(zeros))
+        .map(|(piece, zeros)| files::Piece {
+            backing: match zeros {
+                true => files::Backing {
+                    file: Arc::clone(&own.file),
+                    offset: own.offset + piece.at,
+                },
+                false => piece.backing,
+            },
+            prot: READ_WRITE,
+            ..piece
+        })
+        .collect();
+    vm::map_pieces(twin.first, length, &pieces).ok()?;
+    TWINS.lock().insert(twin.first, (length, first));
+    Some(twin)
+}
+
+/// The address whose bytes the runtime's memory at `at` shows: `at`, but for an address in a
+/// writable twin, the twinned memory's at the same offset (module docs).
+pub(crate) fn shown_at(at: NonNull<u8>) -> NonNull<u8> {
+    let addr = at.as_ptr().addr().to_u64();
+    let twins = TWINS.lock();
+    let Some((&twin, &(length, first))) = twins.range(..=addr).next_back() else {
+        return at;
+    };
+    if addr >= twin + length {
+        return at;
+    }
+    address(first + (addr - twin)).unwrap_or(at)
+}
+
+/// A pointer to `at` in the process's address space; `None` for 0.
+fn address(at: u64) -> Option<NonNull<u8>> {
+    NonNull::new(vm::ptr(at).cast::<u8>())
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::core::platform::os::vm::VmProt;
+
+    use super::*;
+
+    const PAGE: u64 = 0x1000;
+
+    fn read(at: u64) -> u8 {
+        // SAFETY: test memory this test mapped readable.
+        unsafe { address(at).unwrap().as_ptr().read_volatile() }
+    }
+
+    fn write(at: u64, v: u8) {
+        // SAFETY: test memory this test mapped writable.
+        unsafe { address(at).unwrap().as_ptr().write_volatile(v) }
+    }
+
+    fn addr(p: NonNull<u8>) -> u64 {
+        p.as_ptr().addr().to_u64()
+    }
+
+    /// Writable memory is imported as it is; read-only memory through a writable twin of its
+    /// pages, at the same offset, whose writes reach them, so the import keeps writes, and whose
+    /// addresses answer the memory's own until the runtime drops its keep-alive; the deallocator
+    /// is given the memory's own address, and the twin outlives it, and the memory
+    #[test]
+    fn read_only_memory_is_imported_through_a_writable_twin() {
+        let vm = WindowsVm::new();
+        let at = vm::allocate_aliasable(2 * PAGE).unwrap();
+        let first = at.addr().to_u64();
+        let p = address(first + 0x40).unwrap();
+        let view = import_view(p, PAGE, true);
+        assert_eq!(view.at(), p, "writable: the memory itself");
+        assert!(!view.twinned());
+        let (run, kept) = view.release(p, None);
+        assert!(run.is_none() && kept.is_none());
+        assert!(vm.protect_max(at, 2 * PAGE, VmProt::READ).is_ok());
+        let view = import_view(p, PAGE, true);
+        assert!(view.twinned());
+        let twin = addr(view.at());
+        assert_ne!(twin, addr(p));
+        assert_eq!(twin & (PAGE - 1), 0x40, "the offset in its page");
+        assert!(vm::tests::writable(
+            HostAddr::from_addr(twin.to_usize()),
+            PAGE
+        ));
+        write(twin + PAGE, 0x5a);
+        assert_eq!(
+            read(first + 0x40 + PAGE),
+            0x5a,
+            "the twin's writes reach the pages"
+        );
+        assert_eq!(shown_at(view.at()), p);
+        let inside = address(twin + 0x10).unwrap();
+        assert_eq!(addr(shown_at(inside)), addr(p) + 0x10);
+        let given = Arc::new(Mutex::new(None));
+        let seen = Arc::clone(&given);
+        let inner: rt::Deallocator = Box::new(move |at, length| {
+            *seen.lock() = Some((at.as_ptr().addr().to_u64(), length));
+        });
+        let (free, kept) = view.release(p, Some(inner));
+        free.unwrap()(address(twin).unwrap(), PAGE);
+        assert_eq!(*given.lock(), Some((addr(p), PAGE)));
+        assert_eq!(
+            addr(shown_at(inside)),
+            addr(p) + 0x10,
+            "the twin outlives it"
+        );
+        // The memory goes first: the twin keeps its pages until the runtime lets go of it.
+        assert!(vm.deallocate(at, 2 * PAGE).is_success());
+        assert_eq!(read(twin + PAGE), 0x5a);
+        drop(kept);
+        assert_eq!(addr(shown_at(inside)), twin + 0x10, "the twin is gone");
+    }
+
+    /// Read-only memory imported without a twin (all but a surface's read-only alias) is given as
+    /// it is, read-only and not vouched for, so the runtime finds it read-only, copies it and
+    /// drops the GPU's writes; writable memory is not read-only, with a twin asked for or not
+    #[test]
+    fn read_only_memory_without_a_twin_is_given_as_it_is() {
+        let vm = WindowsVm::new();
+        let at = vm::allocate_aliasable(PAGE).unwrap();
+        let first = at.addr().to_u64();
+        let p = address(first).unwrap();
+        for twin in [false, true] {
+            let view = import_view(p, PAGE, twin);
+            assert_eq!((view.at(), view.read_only()), (p, false), "writable");
+        }
+        assert!(vm.protect_max(at, PAGE, VmProt::READ).is_ok());
+        let view = import_view(p, PAGE, false);
+        assert_eq!(view.at(), p, "the pages themselves");
+        assert!(view.read_only() && !view.twinned());
+        assert!(!view.vouched());
+        let (run, kept) = view.release(p, None);
+        assert!(run.is_none() && kept.is_none());
+        let twinned = import_view(p, PAGE, true);
+        assert!(twinned.read_only() && twinned.twinned());
+        drop(twinned);
+        assert!(vm.deallocate(at, PAGE).is_success());
+    }
+
+    /// The runtime may be told an import's pages are writable only where the table shows every
+    /// one mapped writable as it is made: a fresh range is vouched for; once one of its pages is
+    /// protected read-only, the next import over it is a twin and is not; and memory the table
+    /// does not know (the process's heap) is not either, and is given as it is
+    #[test]
+    fn only_pages_the_table_shows_writable_are_vouched_for() {
+        let vm = WindowsVm::new();
+        let at = vm::allocate_aliasable(2 * PAGE).unwrap();
+        let first = at.addr().to_u64();
+        let p = address(first).unwrap();
+        let view = import_view(p, 2 * PAGE, true);
+        assert_eq!(view.at(), p);
+        assert!(view.vouched(), "every page writable");
+        drop(view);
+        let second = at.wrapping_add(PAGE);
+        assert!(vm.protect_max(second, PAGE, VmProt::READ).is_ok());
+        let view = import_view(p, 2 * PAGE, true);
+        assert!(view.twinned(), "a twin of the read-only page");
+        assert!(!view.vouched(), "a page read-only since the first import");
+        drop(view);
+        let view = import_view(p, PAGE, true);
+        assert!(view.vouched(), "the page still writable");
+        drop(view);
+        assert!(vm.deallocate(at, 2 * PAGE).is_success());
+        let mut heap = vec![0u8; PAGE.to_usize()];
+        let other = NonNull::new(heap.as_mut_ptr()).unwrap();
+        let view = import_view(other, PAGE, true);
+        assert_eq!(view.at(), other);
+        assert!(!view.vouched() && !view.read_only() && !view.twinned());
+        drop(view);
+        drop(heap);
+    }
+
+    /// A twin of zeros is zeros of its own: its writes never reach the shared section
+    #[test]
+    fn a_twin_of_zeros_keeps_its_writes_to_itself() {
+        let vm = WindowsVm::new();
+        let at = allocate_zeros(PAGE).unwrap();
+        let first = at.addr().to_u64();
+        assert_eq!(of_zeros(&files::pieces(first, 1).unwrap()), [true]);
+        assert!(vm.protect_max(at, PAGE, VmProt::READ).is_ok());
+        let p = address(first).unwrap();
+        let view = import_view(p, PAGE, true);
+        let twin = addr(view.at());
+        assert_ne!(twin, first);
+        assert_eq!(read(twin), 0);
+        write(twin, 7);
+        assert_eq!((read(twin), read(first)), (7, 0));
+        drop(view);
+        assert!(vm.deallocate(at, PAGE).is_success());
+    }
+
+    /// A read-only alias of guest pages shorter than its size, a heap's or a replace's, is
+    /// imported through a writable twin: the pages' bytes, whose writes reach the guest's, then
+    /// zeros of the twin's own past them, as its zeros map the block of zeros
+    #[test]
+    fn a_read_only_alias_with_zeros_past_its_pages_is_twinned() {
+        use crate::core::platform::types::ResourceAddressRange;
+
+        let vm = WindowsVm::new();
+        let guest = vm::allocate_aliasable(PAGE).unwrap();
+        let first = guest.addr().to_u64();
+        write(first + 5, 0x6b);
+        let ranges = [ResourceAddressRange {
+            address: first,
+            length: PAGE,
+        }];
+        let alias = crate::gpu::backing::gather("test", &ranges, 3 * PAGE, true).unwrap();
+        let at = alias.first();
+        let view = import_view(at, 3 * PAGE, true);
+        let twin = addr(view.at());
+        assert_ne!(twin, addr(at), "a twin");
+        assert_eq!(read(twin + 5), 0x6b, "the guest's page");
+        assert_eq!((read(twin + PAGE), read(twin + 3 * PAGE - 1)), (0, 0));
+        write(twin + 2 * PAGE, 9);
+        assert_eq!(
+            read(addr(at) + 2 * PAGE),
+            0,
+            "the alias's zeros keep none of it"
+        );
+        write(twin + 6, 0x7c);
+        assert_eq!(read(first + 6), 0x7c, "the guest's page takes the write");
+        drop(view);
+        drop(alias);
+        assert!(vm.deallocate(guest, PAGE).is_success());
+    }
+}
