+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "ui/input.h"
+#include "migration/vmstate.h"
+#include "hw/input/hid.h"
+
+#define HID_USAGE_ERROR_ROLLOVER 1
+static void trace_hid_kbd_queue_empty(void) { }
+#include "hid-jis-under-test.h"
+
+static void feed(HIDState *s, uint8_t code, uint8_t report[8])
+{
+    assert(s->n == 0);
+    s->kbd.keycodes[s->head] = code;
+    s->n = 1;
+    assert(hid_keyboard_poll(s, report, 8) == 8);
+}
+
+int main(void)
+{
+    const uint8_t cases[][2] = {
+        {0x71, 0x91}, /* Eisu / Lang2 */
+        {0x72, 0x90}, /* Kana / Lang1 */
+        {0x73, 0x87}, /* JIS Ro */
+        {0x7d, 0x89}, /* JIS Yen */
+        {0x1e, 0x04}, /* ordinary A */
+    };
+    for (unsigned i = 0; i < G_N_ELEMENTS(cases); i++) {
+        HIDState s = {0};
+        uint8_t report[8];
+        feed(&s, cases[i][0], report);
+        assert(report[0] == 0 && report[2] == cases[i][1] && s.kbd.keys == 1);
+        feed(&s, cases[i][0], report);
+        assert(s.kbd.keys == 1); /* no duplicate held key */
+        feed(&s, cases[i][0] | 0x80, report);
+        assert(report[2] == 0 && s.kbd.keys == 0);
+    }
+    HIDState s = {0};
+    uint8_t report[8];
+    feed(&s, 0xe0, report);
+    feed(&s, 0x5b, report); /* left GUI reaches macOS as Command */
+    assert(report[0] == 8);
+    feed(&s, 0xe0, report);
+    feed(&s, 0xdb, report);
+    assert(report[0] == 0);
+    puts("HID: Eisu, Kana, Ro, Yen, ordinary keys and Command passed");
+    return 0;
+}
diff --git a/tests/unit/test-symlink-install-tree.py b/tests/unit/test-symlink-install-tree.py
new file mode 100644
index 0000000000..c8197436c7
--- /dev/null
+++ b/tests/unit/test-symlink-install-tree.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+import json
+import os
+from pathlib import Path
+import runpy
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+
+
+@unittest.skipUnless(os.name == 'nt', 'Windows symlink fallback')
+class InstallTreeTest(unittest.TestCase):
+    script = Path(__file__).resolve().parents[2] / 'scripts/symlink-install-tree.py'
+
+    def run_script(self, source, winerror):
+        failure = OSError('symlink refused')
+        failure.winerror = winerror
+        output = subprocess.CompletedProcess([], 0,
+            stdout=json.dumps({str(source): str(source)}).encode())
+        with patch.dict(os.environ, {'MESONINTROSPECT': 'meson introspect'}), \
+                patch('subprocess.run', return_value=output), \
+                patch('os.symlink', side_effect=failure):
+            runpy.run_path(str(self.script))
+
+    def test_copy_existing_and_skip_unbuilt(self):
+        previous = Path.cwd()
+        with tempfile.TemporaryDirectory() as directory:
+            try:
+                os.chdir(directory)
+                source = Path(directory) / 'ReimsVgpu.rom'
+                source.write_bytes(b'our option ROM')
+                self.run_script(source, 1314)
+                copies = list(Path('qemu-bundle').rglob(source.name))
+                self.assertEqual(len(copies), 1)
+                self.assertEqual(copies[0].read_bytes(), source.read_bytes())
+                missing = Path(directory) / 'not-built.exe'
+                self.run_script(missing, 1314)
+                self.assertFalse(list(Path('qemu-bundle').rglob(missing.name)))
+            finally:
+                os.chdir(previous)
+
+    def test_other_errors_propagate(self):
+        previous = Path.cwd()
+        with tempfile.TemporaryDirectory() as directory:
+            try:
+                os.chdir(directory)
+                with self.assertRaises(OSError) as caught:
+                    self.run_script(Path(directory) / 'missing', 5)
+                self.assertEqual(caught.exception.winerror, 5)
+            finally:
+                os.chdir(previous)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/unit/test-whpx-reset.c b/tests/unit/test-whpx-reset.c
new file mode 100644
index 0000000000..916eebec55
--- /dev/null
+++ b/tests/unit/test-whpx-reset.c
@@ -0,0 +1,308 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* check-whpx-reset.py compiles the actual WHPX and xstate helpers into this test. */
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "qemu/memalign.h"
+#include "qemu/error-report.h"
+#include "host-cpu.h"
+#include <winhvplatform.h>
+#include "system/whpx.h"
+#include "system/whpx-internal.h"
+#include "system/whpx-common.h"
+#include "system/whpx-accel-ops.h"
+#include "whpx/whpx-i386.h"
+
+#undef X86_CPU
+#define X86_CPU(cs) container_of(cs, X86CPU, parent_obj)
+#ifndef WHV_E_INSUFFICIENT_BUFFER
+#define WHV_E_INSUFFICIENT_BUFFER ((HRESULT)0x80370301)
+#endif
+
+struct whpx_state whpx_global;
+struct WHPDispatch whp_dispatch;
+bool whpx_irqchip_in_kernel = true;
+static bool legacy, fail_read, fail_registers, short_read;
+static unsigned read_calls, sets, registers, errors;
+static UINT32 required_size = 4096;
+static uint64_t mtrr_cap;
+static bool fail_mtrr_query, fail_mtrr_write;
+static unsigned mtrr_writes;
+
+bool target_big_endian(void)
+{
+    return false;
+}
+
+void error_report(const char *fmt, ...)
+{
+    errors++;
+}
+
+void *qemu_memalign(size_t alignment, size_t size)
+{
+    void *p = _aligned_malloc(size, alignment);
+    assert(p);
+    return p;
+}
+
+void qemu_vfree(void *p)
+{
+    _aligned_free(p);
+}
+
+int getpagesize(void)
+{
+    return 4096;
+}
+
+bool whpx_is_legacy_os(void)
+{
+    return legacy;
+}
+
+bool whpx_has_xsave(void)
+{
+    return true;
+}
+
+static size_t whpx_get_xsave_max_len(void)
+{
+    return 832;
+}
+
+void cpu_x86_cpuid(CPUX86State *env, uint32_t leaf, uint32_t subleaf,
+                   uint32_t *eax, uint32_t *ebx, uint32_t *ecx, uint32_t *edx)
+{
+    assert(leaf == 0xd && subleaf == XSTATE_YMM_BIT);
+    *eax = x86_ext_save_areas[subleaf].size;
+    *ebx = x86_ext_save_areas[subleaf].offset;
+    *ecx = *edx = 0;
+}
+
+static HRESULT WINAPI get_legacy(WHV_PARTITION_HANDLE partition, UINT32 vp,
+                                 void *buffer, UINT32 size, UINT32 *written)
+{
+    X86XSaveHeader *header;
+    uint64_t value = UINT64_C(0x1122334455667788);
+
+    read_calls++;
+    if (fail_read) {
+        return E_FAIL;
+    }
+    *written = required_size;
+    if (size < required_size) {
+        return WHV_E_INSUFFICIENT_BUFFER;
+    }
+    memset(buffer, 0, size);
+    header = (void *)((uint8_t *)buffer + sizeof(X86LegacyXSaveArea));
+    header->xstate_bv = 7;
+    header->xcomp_bv = (UINT64_C(1) << 63) | 7;
+    memcpy((uint8_t *)buffer + x86_ext_save_areas[XSTATE_YMM_BIT].offset,
+           &value, sizeof(value));
+    if (short_read) {
+        *written = 8;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI get_modern(WHV_PARTITION_HANDLE partition, UINT32 vp,
+                                 WHV_VIRTUAL_PROCESSOR_STATE_TYPE type,
+                                 void *buffer, UINT32 size, UINT32 *written)
+{
+    assert(type == WHvVirtualProcessorStateTypeXsaveState);
+    return get_legacy(partition, vp, buffer, size, written);
+}
+
+static HRESULT WINAPI set_legacy(WHV_PARTITION_HANDLE partition, UINT32 vp,
+                                 void *buffer, UINT32 size)
+{
+    sets++;
+    assert(size == required_size);
+    assert(((X86XSaveHeader *)((uint8_t *)buffer +
+                              sizeof(X86LegacyXSaveArea)))->xstate_bv == 0);
+    for (unsigned i = 832; i < size; i++) {
+        assert(((uint8_t *)buffer)[i] == 0);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI set_modern(WHV_PARTITION_HANDLE partition, UINT32 vp,
+                                 WHV_VIRTUAL_PROCESSOR_STATE_TYPE type,
+                                 void *buffer, UINT32 size)
+{
+    assert(type == WHvVirtualProcessorStateTypeXsaveState);
+    return set_legacy(partition, vp, buffer, size);
+}
+
+static HRESULT WINAPI set_registers(WHV_PARTITION_HANDLE partition, UINT32 vp,
+                                    const WHV_REGISTER_NAME *names, UINT32 count,
+                                    const WHV_REGISTER_VALUE *values)
+{
+    static const WHV_REGISTER_NAME expected[] = {
+        WHvRegisterPendingInterruption, WHvRegisterPendingEvent,
+        WHvRegisterInterruptState, WHvX64RegisterDeliverabilityNotifications,
+        WHvRegisterInternalActivityState,
+    };
+    registers++;
+    if (fail_registers) {
+        return E_FAIL;
+    }
+    if (names[0] == WHvX64RegisterMsrMtrrDefType) {
+        unsigned idx = 0;
+        assert(names[idx++] == WHvX64RegisterMsrMtrrDefType);
+        if (mtrr_cap & MSR_MTRRcap_FIXRANGE_SUPPORT) {
+            for (unsigned i = 0; i < 11; i++) {
+                assert(names[idx++] == WHvX64RegisterMsrMtrrFix64k00000 + i);
+            }
+        }
+        for (unsigned i = 0; i < (mtrr_cap & 0xff); i++) {
+            assert(names[idx++] == WHvX64RegisterMsrMtrrPhysBase0 + i);
+            assert(names[idx++] == WHvX64RegisterMsrMtrrPhysMask0 + i);
+        }
+        assert(count == idx);
+        for (unsigned i = 0; i < count; i++) {
+            assert(values[i].Reg128.Low64 == 0 && values[i].Reg128.High64 == 0);
+        }
+        if (fail_mtrr_write) {
+            return E_FAIL;
+        }
+        mtrr_writes++;
+        return S_OK;
+    }
+    assert(count == ARRAY_SIZE(expected) - !whpx_irqchip_in_kernel);
+    for (unsigned i = 0; i < count; i++) {
+        assert(names[i] == expected[i]);
+        assert(values[i].Reg128.Low64 ==
+               (i == count - 1 && whpx_irqchip_in_kernel && vp != 0));
+        assert(values[i].Reg128.High64 == 0);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI get_registers(WHV_PARTITION_HANDLE partition, UINT32 vp,
+                                    const WHV_REGISTER_NAME *names, UINT32 count,
+                                    WHV_REGISTER_VALUE *values)
+{
+    assert(count == 1 && names[0] == WHvX64RegisterMsrMtrrCap);
+    if (fail_mtrr_query) {
+        return E_FAIL;
+    }
+    values[0].Reg64 = mtrr_cap;
+    return S_OK;
+}
+
+#include "whpx-reset-under-test.h"
+
+int main(void)
+{
+    uint32_t eax, ebx, ecx, edx;
+
+    host_cpuid(0xd, XSTATE_YMM_BIT, &eax, &ebx, &ecx, &edx);
+    x86_ext_save_areas[XSTATE_YMM_BIT].offset = ebx;
+    whp_dispatch.WHvGetVirtualProcessorState = get_modern;
+    whp_dispatch.WHvGetVirtualProcessorXsaveState = get_legacy;
+    whp_dispatch.WHvSetVirtualProcessorState = set_modern;
+    whp_dispatch.WHvSetVirtualProcessorXsaveState = set_legacy;
+    whp_dispatch.WHvSetVirtualProcessorRegisters = set_registers;
+    whp_dispatch.WHvGetVirtualProcessorRegisters = get_registers;
+
+    for (unsigned api = 0; api < 2; api++) {
+        legacy = api;
+        for (unsigned vp = 0; vp < 8; vp++) {
+            X86CPU cpu = {0};
+            AccelCPUState accel = {0};
+            CPUState *cs = &cpu.parent_obj;
+            unsigned before;
+
+            cs->accel = &accel;
+            cs->cpu_index = vp;
+            cs->halted = vp != 0;
+            cpu.env.xsave_buf_len = 832;
+            cpu.env.xsave_buf = qemu_memalign(4096, 832);
+            cpu.env.features[FEAT_XSAVE_XCR0_LO] = 7;
+            before = read_calls;
+            if (whpx_get_xsave_state(cs) < 0) {
+                fputs("FAIL XSAVE read did not negotiate required buffer size\n",
+                      stderr);
+                return 1;
+            }
+            assert(read_calls == before + 2 && accel.xsave_state_size == required_size);
+            assert(cpu.env.xmm_regs[0].ZMM_Q(2) == UINT64_C(0x1122334455667788));
+            before = read_calls;
+            assert(whpx_get_xsave_state(cs) == 0 && read_calls == before + 1);
+
+            cpu.env.xstate_bv = 0;
+            memset(cpu.env.xmm_regs, 0, sizeof(cpu.env.xmm_regs));
+            cpu.env.cr[4] = 0;
+            before = sets;
+            test_xstate_write(cs, WHPX_LEVEL_RESET_STATE);
+            assert(sets == before + 1);
+            test_xstate_write(cs, WHPX_LEVEL_RUNTIME_STATE);
+            assert(sets == before + 1);
+            cpu.env.cr[4] = CR4_OSXSAVE_MASK;
+            accel.xsave_state_stale = true;
+            test_xstate_write(cs, WHPX_LEVEL_RUNTIME_STATE);
+            assert(sets == before + 1);
+
+            accel.window_registered = accel.ready_for_pic_interrupt = true;
+            accel.interruptable = accel.interruption_pending = true;
+            accel.window_priority = 0x70;
+            accel.xsave_state_stale = true;
+            memset(&accel.exit_ctx, 0xff, sizeof(accel.exit_ctx));
+            assert(whpx_reset_vcpu_state(cs));
+            assert(!accel.window_registered && !accel.ready_for_pic_interrupt);
+            assert(!accel.interruptable && !accel.interruption_pending);
+            assert(!accel.xsave_state_stale && accel.window_priority == 0);
+            assert(accel.exit_ctx.ExitReason == 0);
+            assert(accel.xsave_state_size == required_size);
+
+            whpx_irqchip_in_kernel = false;
+            assert(whpx_reset_vcpu_state(cs));
+            whpx_irqchip_in_kernel = true;
+
+            fail_registers = true;
+            accel.interruption_pending = true;
+            assert(!whpx_reset_vcpu_state(cs) && accel.interruption_pending);
+            fail_registers = false;
+            fail_read = true;
+            before = read_calls;
+            assert(whpx_get_xsave_state(cs) < 0 && read_calls == before + 1);
+            assert(accel.xsave_state_stale);
+            fail_read = false;
+            short_read = true;
+            assert(whpx_get_xsave_state(cs) < 0 && accel.xsave_state_stale);
+            short_read = false;
+            qemu_vfree(cpu.env.xsave_buf);
+        }
+        printf("PASS %s API: 8 VPs, size retry/cache/writeback, pending reset, "
+               "and explicit failure paths\n", legacy ? "legacy" : "modern");
+    }
+    assert(sets == 16 && registers == 48 && errors == 48);
+    {
+        X86CPU cpu = {0};
+        AccelCPUState accel = {0};
+        CPUState *cs = &cpu.parent_obj;
+        const unsigned counts[] = {0, 8, 16};
+        cs->accel = &accel;
+        cpu.env.features[FEAT_1_EDX] = CPUID_MTRR;
+        for (unsigned fixed = 0; fixed < 2; fixed++) {
+            for (unsigned i = 0; i < ARRAY_SIZE(counts); i++) {
+                mtrr_cap = counts[i] | (fixed ? MSR_MTRRcap_FIXRANGE_SUPPORT : 0);
+                assert(whpx_reset_vcpu_state(cs));
+            }
+        }
+        assert(mtrr_writes == 6);
+        accel.interruption_pending = true;
+        fail_mtrr_query = true;
+        assert(!whpx_reset_vcpu_state(cs) && accel.interruption_pending);
+        fail_mtrr_query = false;
+        mtrr_cap = 17;
+        assert(!whpx_reset_vcpu_state(cs) && accel.interruption_pending);
+        mtrr_cap = 8;
+        fail_mtrr_write = true;
+        assert(!whpx_reset_vcpu_state(cs) && accel.interruption_pending);
+        assert(mtrr_writes == 6);
+        puts("PASS MTRR reset: fixed/variable ranges, 0/8/16 banks and failures");
+    }
+    return 0;
+}
diff --git a/tests/unit/test-whpx-topology.c b/tests/unit/test-whpx-topology.c
new file mode 100644
index 0000000000..e773bc89f0
--- /dev/null
+++ b/tests/unit/test-whpx-topology.c
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Run with check-whpx-topology.py: the generated header contains real source. */
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "whpx-topology-under-test.h"
+
+static bool rejects_without_changes(X86CPU *cpu, uint32_t msr, bool write)
+{
+    X86CPU before;
+    uint64_t value = UINT64_C(0xfedcba9876543210);
+
+    memcpy(&before, cpu, sizeof(before));
+    return !whpx_access_msr(&cpu->env, msr, write, &value) &&
+           value == UINT64_C(0xfedcba9876543210) &&
+           memcmp(&before, cpu, sizeof(before)) == 0;
+}
+
+int main(void)
+{
+    const struct {
+        const char *name;
+        X86CPUTopoInfo topology; /* dies, modules, cores, threads */
+        unsigned packages;
+        uint64_t expected;
+    } cases[] = {
+        { "8 cores, no SMT", {1, 1, 8, 1}, 1, UINT64_C(0x00080008) },
+        { "8 cores, SMT", {1, 1, 8, 2}, 1, UINT64_C(0x00080010) },
+        { "2 packages, 4 cores, SMT", {1, 1, 4, 2}, 2,
+          UINT64_C(0x00040008) },
+        { "2 packages, multiple dies/modules, SMT", {2, 2, 2, 2}, 2,
+          UINT64_C(0x00080010) },
+    };
+
+    for (unsigned i = 0; i < ARRAY_SIZE(cases); i++) {
+        for (unsigned package = 0; package < cases[i].packages; package++) {
+            X86CPU cpu = {0};
+            uint64_t value = UINT64_MAX, reference;
+            bool accepted;
+
+            cpu.env.topo_info = cases[i].topology;
+            cpu.socket_id = package;
+            reference = cpu_x86_get_msr_core_thread_count(&cpu);
+            accepted = whpx_access_msr(&cpu.env, MSR_CORE_THREAD_COUNT,
+                                       false, &value);
+            if (!accepted || value != cases[i].expected || value != reference) {
+                fprintf(stderr, "FAIL %s package %u: accepted=%d value=%" PRIx64
+                        " helper=%" PRIx64 " expected=%" PRIx64 "\n",
+                        cases[i].name, package, accepted, value, reference,
+                        cases[i].expected);
+                return EXIT_FAILURE;
+            }
+            if (!rejects_without_changes(&cpu, MSR_CORE_THREAD_COUNT, true) ||
+                !rejects_without_changes(&cpu, UINT32_MAX, false) ||
+                !rejects_without_changes(&cpu, UINT32_MAX, true)) {
+                fprintf(stderr, "FAIL %s package %u: refusal changed state\n",
+                        cases[i].name, package);
+                return EXIT_FAILURE;
+            }
+            printf("PASS %s package %u: MSR 0x35=%" PRIx64
+                   "; read-only and unknown-MSR refusals preserve state\n",
+                   cases[i].name, package, value);
+        }
+    }
+    return EXIT_SUCCESS;
+}
diff --git a/tests/unit/test-win32-ram.c b/tests/unit/test-win32-ram.c
new file mode 100644
index 0000000000..109300bf22
--- /dev/null
+++ b/tests/unit/test-win32-ram.c
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+
+static void test_section_alias(void)
+{
+    const size_t granularity = 65536;
+    const size_t size = 2 * granularity;
+    HANDLE section, duplicate;
+    uint64_t align = 0;
+    uint8_t *ram = qemu_win32_ram_alloc(size, &align, false, &section);
+    uint8_t *alias, *retained;
+
+    g_assert_nonnull(ram);
+    g_assert_nonnull(section);
+    g_assert_cmpuint((uintptr_t)ram % align, ==, 0);
+    g_assert_cmpuint(ram[0], ==, 0);
+    g_assert_cmpuint(ram[size - 1], ==, 0);
+    alias = MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, granularity,
+                          granularity);
+    g_assert_nonnull(alias);
+    ram[granularity] = 0x5a;
+    g_assert_cmpuint(alias[0], ==, 0x5a);
+    alias[granularity - 1] = 0xa5;
+    g_assert_cmpuint(ram[size - 1], ==, 0xa5);
+
+    g_assert_true(DuplicateHandle(GetCurrentProcess(), section,
+                                  GetCurrentProcess(), &duplicate, 0, false,
+                                  DUPLICATE_SAME_ACCESS));
+    qemu_anon_ram_free(ram, size);
+    g_assert_true(CloseHandle(section));
+    retained = MapViewOfFile(duplicate, FILE_MAP_ALL_ACCESS, 0, 0, size);
+    g_assert_nonnull(retained);
+    g_assert_cmpuint(retained[granularity], ==, 0x5a);
+    alias[1] = 0x42;
+    g_assert_cmpuint(retained[granularity + 1], ==, 0x42);
+    g_assert_true(UnmapViewOfFile(alias));
+    qemu_anon_ram_free(retained, size);
+    g_assert_true(CloseHandle(duplicate));
+}
+
+static void test_allocation_failures(void)
+{
+    HANDLE section = INVALID_HANDLE_VALUE;
+
+    g_assert_null(qemu_win32_ram_alloc(65536, NULL, true, &section));
+    g_assert_null(section);
+    g_assert_cmpint(errno, ==, ENOTSUP);
+    g_assert_null(qemu_win32_ram_alloc(0, NULL, false, &section));
+    g_assert_null(section);
+    g_assert_cmpint(errno, ==, ENOMEM);
+}
+
+static void test_anonymous_view(void)
+{
+    uint8_t *ram = qemu_anon_ram_alloc(4096, NULL, false, false);
+    MEMORY_BASIC_INFORMATION info;
+
+    g_assert_nonnull(ram);
+    g_assert_cmpuint(VirtualQuery(ram, &info, sizeof(info)), ==, sizeof(info));
+    g_assert_cmpuint(info.Type, ==, MEM_MAPPED);
+    ram[4095] = 0x42;
+    g_assert_cmpuint(ram[4095], ==, 0x42);
+    qemu_anon_ram_free(ram, 4096);
+    qemu_anon_ram_free(NULL, 0);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/win32-ram/section-alias", test_section_alias);
+    g_test_add_func("/win32-ram/allocation-failures", test_allocation_failures);
