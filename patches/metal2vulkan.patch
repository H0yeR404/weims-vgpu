+++ b/crates/metal2vulkan-runtime/src/non_unix.rs
@@ -0,0 +1,173 @@
+//! What the modules built on every system name of the two that are Unix's alone, where the crate
+//! is built off Unix (Windows): `dma_buf.rs` (a dma-buf is a file descriptor) and
+//! `host_residency.rs` (which keeps dma-bufs' descriptors within `RLIMIT_NOFILE`). Nothing here
+//! makes a dma-buf or releases an import while idle: each item is the answer of a system that has
+//! neither, under the name and signature its Unix counterpart has, so that the callers read the
+//! same on both. `lib.rs` names the two modules below `dma_buf` and `host_residency`.
+
+/// `dma_buf.rs` off Unix.
+pub(crate) mod dma_buf {
+    use crate::error::Error;
+    use crate::host_memory::Importer;
+    use crate::memory::Placement;
+    use crate::Device;
+    use ash::vk;
+    use std::ops::Range;
+
+    /// A source of dma-bufs of host pages: none can be made on this system, as
+    /// `host_memory::Source` is none (`HostRam::with_dma_buf` and `HostMemory::with_dma_buf` are
+    /// Unix's), so an `Option` of it is always `None`.
+    pub(crate) type DmaBufSource = std::convert::Infallible;
+
+    /// A source of dma-bufs of run lists (`HostRam::with_dma_buf_of_runs`, Unix's): none.
+    pub(crate) type DmaBufRunsSource = std::convert::Infallible;
+
+    const DMA_BUF: vk::ExternalMemoryHandleTypeFlags =
+        vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT;
+
+    /// The memory an image in place is made for: `dma_buf.rs`'s `ModifierMemory`, variant for
+    /// variant, of which this system's textures take `Host` (host pages imported by their
+    /// pointer) and `Own` (the runtime's own memory).
+    #[allow(dead_code)]
+    #[derive(Clone, Copy, PartialEq, Eq)]
+    pub(crate) enum ModifierMemory {
+        DmaBuf,
+        Host,
+        Own,
+        Exported(vk::ExternalMemoryHandleTypeFlags),
+    }
+
+    impl std::fmt::Debug for ModifierMemory {
+        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+            match self {
+                ModifierMemory::DmaBuf => f.write_str("DmaBuf"),
+                ModifierMemory::Host => f.write_str("Host"),
+                ModifierMemory::Own => f.write_str("Own"),
+                ModifierMemory::Exported(handle) => write!(f, "Exported({:#x})", handle.as_raw()),
+            }
+        }
+    }
+
+    #[allow(dead_code)]
+    impl ModifierMemory {
+        /// The external memory handle type the image is made for; none for the runtime's own
+        /// memory of no export.
+        pub(crate) fn handle_type(self) -> Option<vk::ExternalMemoryHandleTypeFlags> {
+            match self {
+                ModifierMemory::DmaBuf => Some(DMA_BUF),
+                ModifierMemory::Host => {
+                    Some(vk::ExternalMemoryHandleTypeFlags::HOST_ALLOCATION_EXT)
+                }
+                ModifierMemory::Own => None,
+                ModifierMemory::Exported(handle) => Some(handle),
+            }
+        }
+
+        /// The memory, in words.
+        pub(crate) fn words(self) -> &'static str {
+            match self {
+                ModifierMemory::DmaBuf => "dma-bufs",
+                ModifierMemory::Host => "host allocations",
+                ModifierMemory::Own => "the runtime's own memory",
+                ModifierMemory::Exported(DMA_BUF) => "the runtime's memory exported as dma-bufs",
+                ModifierMemory::Exported(_) => {
+                    "the runtime's memory exported as opaque file descriptors"
+                }
+            }
+        }
+
+        /// The external memory features the image's handle type must have.
+        pub(crate) fn needs(self) -> vk::ExternalMemoryFeatureFlags {
+            match self {
+                ModifierMemory::Exported(_) => vk::ExternalMemoryFeatureFlags::EXPORTABLE,
+                ModifierMemory::DmaBuf | ModifierMemory::Host | ModifierMemory::Own => {
+                    vk::ExternalMemoryFeatureFlags::IMPORTABLE
+                }
+            }
+        }
+
+        /// Whether the image is bound at an offset of memory it shares.
+        pub(crate) fn shared_memory(self) -> bool {
+            match self {
+                ModifierMemory::Host | ModifierMemory::Exported(_) => true,
+                ModifierMemory::DmaBuf | ModifierMemory::Own => false,
+            }
+        }
+    }
+
+    impl Device {
+        /// Whether the device makes `DRM_FORMAT_MOD_LINEAR` images, as `dma_buf.rs` answers it: it
+        /// enables `VK_EXT_image_drm_format_modifier` beside its dma-buf imports, which no device
+        /// of this system has, and no image is laid out by DRM format modifier here either way
+        /// (`texture/in_place_image.rs`'s `pitched_image`).
+        pub(crate) fn makes_modifier_images(&self) -> bool {
+            (self.shared().host_import.as_ref())
+                .is_ok_and(|importer| importer.makes_dma_buf_images())
+        }
+
+        /// Whether the device imports a pointer to shared memory, which `host_shared_pointers.rs`
+        /// asks of it by an import on Unix: not asked here. `host_ram.rs` asks only for a RAM
+        /// whose ranges it finds shared, which it finds on Linux alone, where a device met
+        /// refuses them; as there, no device is taken to refuse them.
+        pub(crate) fn imports_shared_host_pointers_now(&self) -> Result<bool, Error> {
+            Ok(true)
+        }
+
+        /// `dma_buf.rs`'s, of a source that cannot be.
+        ///
+        /// # Safety
+        ///
+        /// None: no source exists to call it with.
+        pub(crate) unsafe fn ram_takes_dma_bufs(
+            &self,
+            _importer: &Importer,
+            _page: Range<u64>,
+            source: &DmaBufSource,
+        ) -> bool {
+            match *source {}
+        }
+
+        /// `dma_buf.rs`'s, of a source that cannot be.
+        ///
+        /// # Safety
+        ///
+        /// None: no source exists to call it with.
+        pub(crate) unsafe fn ram_span_as_dma_buf(
+            &self,
+            _importer: &Importer,
+            _span: Range<u64>,
+            source: &DmaBufSource,
+        ) -> Result<(vk::Buffer, Placement), Error> {
+            match *source {}
+        }
+
+        /// `dma_buf.rs`'s, of a source that cannot be.
+        ///
+        /// # Safety
+        ///
+        /// None: no source exists to call it with.
+        pub(crate) unsafe fn ram_runs_as_dma_buf(
+            &self,
+            _importer: &Importer,
+            _runs: &[Range<u64>],
+            source: &DmaBufRunsSource,
+        ) -> Result<(vk::Buffer, Placement), Error> {
+            match *source {}
+        }
+    }
+}
+
+/// `host_residency.rs` off Unix: its windows, which a guest RAM's idle chunks share
+/// (`host_ram.rs`). No import of a no-copy buffer is released while idle here (`buffer.rs`).
+pub(crate) mod host_residency {
+    use std::time::Duration;
+
+    /// How long an import waits idle before its first release.
+    pub(crate) const IDLE: Duration = Duration::from_secs(2);
+
+    /// The longest an import waits idle, its window doubled at each import again.
+    pub(crate) const IDLE_MOST: Duration = Duration::from_secs(64);
+
+    /// How often the residency thread looks for idle imports.
+    pub(crate) const TICK: Duration = Duration::from_millis(500);
+}
