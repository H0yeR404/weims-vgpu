+/// Windows' host clock: the performance counter (`QueryPerformanceCounter`), in nanoseconds
+/// since the system started, as `CLOCK_MONOTONIC_RAW` counts on Unix. It is the clock of Vulkan's
+/// `VK_TIME_DOMAIN_QUERY_PERFORMANCE_COUNTER_KHR`, whose values are the counter's ticks.
+#[cfg(windows)]
+mod performance_counter {
+    use std::sync::OnceLock;
+
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn QueryPerformanceCounter(count: *mut i64) -> i32;
+        fn QueryPerformanceFrequency(frequency: *mut i64) -> i32;
+    }
+
+    /// The counter's ticks per second, fixed while the system runs: `None` where the system
+    /// answers none.
+    fn frequency() -> Option<u64> {
+        static FREQUENCY: OnceLock<Option<u64>> = OnceLock::new();
+        *FREQUENCY.get_or_init(|| {
+            let mut frequency = 0i64;
+            // SAFETY: the call writes one integer to the live output.
+            let answered = unsafe { QueryPerformanceFrequency(&mut frequency) } != 0;
+            let frequency = u64::try_from(frequency).ok().filter(|&ticks| ticks > 0);
+            frequency.filter(|_| answered)
+        })
+    }
+
+    /// `ticks` of the counter in nanoseconds: whole seconds and the rest apart, so no product
+    /// passes 64 bits before the counter itself would (centuries of uptime).
+    pub(super) fn nanos(ticks: u64) -> Option<u64> {
+        let frequency = frequency()?;
+        let (seconds, rest) = (ticks / frequency, ticks % frequency);
+        let rest = u128::from(rest) * 1_000_000_000 / u128::from(frequency);
+        seconds
+            .checked_mul(1_000_000_000)?
+            .checked_add(u64::try_from(rest).ok()?)
+    }
+
+    /// The counter now, in nanoseconds.
+    pub(super) fn now() -> Option<u64> {
+        let mut ticks = 0i64;
+        // SAFETY: the call writes one integer to the live output.
+        if unsafe { QueryPerformanceCounter(&mut ticks) } == 0 {
+            return None;
+        }
+        nanos(u64::try_from(ticks).ok()?)
+    }
+}
